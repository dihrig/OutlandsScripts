// ==========================================================
// Nox Single - targeting + single target rotation in one script
// Press the hotkey: a Poison cursor appears, click your enemy.
// If your last target is still alive and in range, the script
// continues on it instead (no cursor) - e.g. after stopping to move.
// Press again to stop.
//
// Phase 1: fast Poison casts until the wanted level lands
// Phase 2: rotation on that one target, one action per pass:
//   escape > heals/cures/potions > Leyline > keep poison up > buff spells >
//   Poison Strike > necro debuffs > Mana Drain > damage spells
// ==========================================================

// ===== CONFIG =====
// Escape on enemy players via Tracking.
// To DISABLE: put // in front of the createlist line below.
if listexists 'cfg_escape'
    removelist 'cfg_escape'
endif
//createlist 'cfg_escape'

// Tracking gump button: 7 = Players, 8 = hostile players only
@setvar! TrackButton 7

// Poison level: 1 = Deadly, 2 = Lethal
@setvar! NoxLevel 2

// Poison Strike when this many ticks or fewer are left (2 - 9)
@setvar! StrikeTicks 7

// Necro debuffs (1 = on, 0 = off)
@setvar! UseCorpseSkin 1
@setvar! UseMindRot 1
@setvar! UseEvilOmen 0
@setvar! UseStrangle 0

// Damage spells only above this mana (keeps mana for Poison and heals)
@setvar! NukeMana 40
// Mind Blast as filler (1 = on, 0 = off)
@setvar! UseMindBlast 1

// Leyline (Arcane weapon ability 2) on cooldown (1 = on, 0 = off)
@setvar! UseLeyline 1
// Wait this long after Leyline went off before trying again (ms).
// 60000 comes from community scripts - CHECK IN-GAME: if your Leyline
// cooldown bar is shorter, lower this. A try that is still on cooldown
// is simply retried 3 s later.
@setvar! LeylineCD 60000

// Buffs kept up during the fight (1 = on, 0 = off)
// Spells: one per pass, only when not badly hurt and above KeepMana
@setvar! UseProtection 1
@setvar! UseReactiveArmor 1
@setvar! UseMagicReflect 1
@setvar! UseCunning 1
// Potions: drunk whenever the buff is missing (not spells, no delay)
@setvar! UseStrPot 1
@setvar! UseAgiPot 1
@setvar! UseResistPot 1

// Heal thresholds (missing hit points)
@setvar! HealPotDiff 30
@setvar! GreaterHealDiff 30
// Poison, Mana Drain and buff spells are not cast below this much mana, so
// there is always enough left for a Greater Heal (11). 0 = off
@setvar! KeepMana 22

// When the target dies: 1 = take the closest grey monster, 0 = stop
@setvar! AutoNext 1

// On start, continue on your last target if it is still alive and in
// range (1 = on, 0 = always ask with a Poison cursor)
@setvar! ResumeLastTarget 1

// ===== Toggle =====
// The multi target script can't be running at the same time
if listexists 'nox_multi'
    removelist 'nox_multi'
endif
if listexists 'nox_single'
    removelist 'nox_single'
    if targetexists
        hotkey 'Cancel Current Target'
    endif
    overhead 'Single target OFF' 33
    stop
endif
createlist 'nox_single'

// Reset state flags from any previous run
if listexists 'f_leytry'
    removelist 'f_leytry'
endif
if listexists 'f_player'
    removelist 'f_player'
endif
if targetexists
    hotkey 'Cancel Current Target'
    wait 100
endif

// Remembers the last mana-drained enemy (kept between runs)
if not listexists 'lastdrain'
    createlist 'lastdrain'
endif

// ===== Timers (99999 = ready immediately) =====
if not timerexists 'manadrain'
    createtimer 'manadrain'
    settimer 'manadrain' 99999
endif
if not timerexists 'arrow'
    createtimer 'arrow'
    settimer 'arrow' 99999
endif
if not timerexists 'lightning'
    createtimer 'lightning'
    settimer 'lightning' 99999
endif
if not timerexists 'healpot'
    createtimer 'healpot'
    settimer 'healpot' 99999
endif
if not timerexists 'curepot'
    createtimer 'curepot'
    settimer 'curepot' 99999
endif
if not timerexists 'gheal'
    createtimer 'gheal'
    settimer 'gheal' 99999
endif
if not timerexists 'mushroom'
    createtimer 'mushroom'
    settimer 'mushroom' 99999
endif
if not timerexists 'mushtry'
    createtimer 'mushtry'
    settimer 'mushtry' 99999
endif
if not timerexists 'tracktry'
    createtimer 'tracktry'
    settimer 'tracktry' 99999
endif
if not timerexists 'explo'
    createtimer 'explo'
    settimer 'explo' 99999
endif
if not timerexists 'poisontry'
    createtimer 'poisontry'
    settimer 'poisontry' 99999
endif
if not timerexists 'lethalseen'
    createtimer 'lethalseen'
    settimer 'lethalseen' 0
endif
if not timerexists 'pstrike'
    createtimer 'pstrike'
    settimer 'pstrike' 99999
endif
if not timerexists 'corpseskin'
    createtimer 'corpseskin'
    settimer 'corpseskin' 99999
endif
if not timerexists 'mindrot'
    createtimer 'mindrot'
    settimer 'mindrot' 99999
endif
if not timerexists 'evilomen'
    createtimer 'evilomen'
    settimer 'evilomen' 99999
endif
if not timerexists 'strangle'
    createtimer 'strangle'
    settimer 'strangle' 99999
endif
if not timerexists 'necrogap'
    createtimer 'necrogap'
    settimer 'necrogap' 99999
endif
if not timerexists 'leyline'
    createtimer 'leyline'
    settimer 'leyline' 99999
endif
if not timerexists 'leytry'
    createtimer 'leytry'
    settimer 'leytry' 99999
endif
if not timerexists 'protry'
    createtimer 'protry'
    settimer 'protry' 99999
endif
if not timerexists 'ratry'
    createtimer 'ratry'
    settimer 'ratry' 99999
endif
if not timerexists 'reflecttry'
    createtimer 'reflecttry'
    settimer 'reflecttry' 99999
endif
if not timerexists 'cuntry'
    createtimer 'cuntry'
    settimer 'cuntry' 99999
endif
if not timerexists 'strpot'
    createtimer 'strpot'
    settimer 'strpot' 99999
endif
if not timerexists 'agipot'
    createtimer 'agipot'
    settimer 'agipot' 99999
endif
if not timerexists 'resistpot'
    createtimer 'resistpot'
    settimer 'resistpot' 99999
endif
if not timerexists 'attackref'
    createtimer 'attackref'
    settimer 'attackref' 99999
endif

// ==========================================================
// PHASE 1: pick the target (last target, or the first Poison cast)
// ==========================================================
@setvar! NoxLanded 0
@setvar! NoxAbort 0
@setvar! NoxResume 0

// The enemy lives in its own variable, so other target hotkeys can't move it.
// Last target still alive and in range? Then continue on it.
if ResumeLastTarget = 1
    @setvar! noxCand lasttarget
    if find noxCand ground -1 -1 12
        if dead noxCand or find noxCand ground -1 -1 0
            // dead, or that's us
        else
            getlabel noxCand candLabel
            if "tame" in candLabel or "summoned" in candLabel
                // own pet - ask for a new enemy
            else
                @setvar! noxMain noxCand
                @setvar! NoxResume 1
            endif
        endif
    endif
endif

if NoxResume = 1
    if queued
        hotkey 'Clear Target Queue'
    endif
    clearsysmsg
    overhead '[ CONTINUE ]' 68 noxMain
else
    if not findtype 3976 self
        overhead 'No Nightshade!' 33
        removelist 'nox_single'
        stop
    endif
    if mana < 9
        overhead 'Not enough mana!' 33
        removelist 'nox_single'
        stop
    endif

    // A Last Target pressed while no cursor was open is queued by Razor and
    // would grab our next cursor, sending the spell to the old target
    if queued
        hotkey 'Clear Target Queue'
    endif
    overhead 'Select enemy' 68
    clearsysmsg
    cast 'Poison'
    waitfortarget 3000
    if not targetexists
        overhead 'Cast did not start - try again' 33
        removelist 'nox_single'
        stop
    endif
    while targetexists
        wait 50
    endwhile

    @setvar! noxMain lasttarget

    if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
        overhead 'No valid target' 33
        removelist 'nox_single'
        stop
    endif
endif

warmode on
attack noxMain
settimer 'attackref' 0
if followers > 0
    say 'All kill'
    waitfortarget 1500
    if targetexists
        target noxMain
    endif
endif

// Fast opening: Poison back to back until the label shows the wanted level.
// No waiting for each result - one extra cast after it lands is fine.
for 12
    // Quick check of the result so far: journal AND target label
    getlabel noxMain noxLabel
    if "Lethal" in noxLabel
        @setvar! NoxLanded 1
    elseif NoxLevel = 1 and "Deadly" in noxLabel
        @setvar! NoxLanded 1
    endif
    if insysmsg 'upgraded to lethal'
        @setvar! NoxLanded 1
    endif
    if NoxLevel = 1 and insysmsg 'upgraded to deadly'
        @setvar! NoxLanded 1
    endif
    if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
        @setvar! NoxAbort 1
    endif
    if insysmsg 'cannot be seen' or insysmsg 'too far away'
        @setvar! NoxAbort 1
    endif
    if NoxLanded = 1 or NoxAbort = 1
        break
    endif
    if mana < 9 or not findtype 3976 self
        break
    endif
    // Heal potion also during the opening
    if diffhits >= HealPotDiff and timer 'healpot' >= 10000 and findtype 3852 self
        dclicktype 3852
        settimer 'healpot' 0
        wait 200
    endif
    // Don't keep casting while badly hurt - the rotation heals first
    if diffhits >= GreaterHealDiff
        break
    endif

    if queued
        hotkey 'Clear Target Queue'
    endif
    clearsysmsg
    cast 'Poison'
    for 40
        if targetexists
            break
        endif
        if insysmsg 'upgraded to lethal'
            @setvar! NoxLanded 1
            break
        endif
        if NoxLevel = 1 and insysmsg 'upgraded to deadly'
            @setvar! NoxLanded 1
            break
        endif
        if insysmsg 'recovered' or insysmsg 'already casting'
            break
        endif
        wait 50
    endfor
    if NoxLanded = 1
        break
    endif
    if targetexists
        if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
            @setvar! NoxAbort 1
            break
        endif
        target noxMain
    else
        // Refused (still recovering): short pause, then try again
        wait 100
    endif
endfor

if targetexists
    hotkey 'Cancel Current Target'
endif
if NoxLanded = 1
    overhead 'Poison landed!' 68
endif

// ==========================================================
// PHASE 2: rotation
// ==========================================================
if listexists 'cfg_escape'
    overhead 'Rotating ! (escape ON)' 68
endif
if not listexists 'cfg_escape'
    overhead 'Rotating ! (escape OFF)' 68
endif
clearsysmsg
settimer 'lethalseen' 0

while listexists 'nox_single' and not dead

    // ===== 1. Read the journal into flags =====
    if listexists 'cfg_escape' and insysmsg ' spaces'
        if not listexists 'f_player'
            createlist 'f_player'
        endif
    endif
    // Did the last Leyline try go off? Refused = still on cooldown, retry in 3 s
    if listexists 'f_leytry'
        removelist 'f_leytry'
        if insysmsg 'cannot perform that ability yet'
            // still on cooldown
        else
            settimer 'leyline' 0
        endif
    endif
    if insysmsg 'consume a magic mushroom'
        settimer 'mushroom' 0
    endif

    // ===== 2. Clear once, after everything has been read =====
    clearsysmsg

    // A Poison cursor that arrived late must never be used by a self-target spell
    if targetexists
        hotkey 'Cancel Current Target'
        wait 100
    endif
    // A Last Target pressed while no cursor was open is queued by Razor and
    // would grab our next cursor, sending the spell to the old target
    if queued
        hotkey 'Clear Target Queue'
    endif

    // ===== 3. Escape =====
    if listexists 'f_player'
        removelist 'f_player'
        overhead 'PLAYER CLOSE! ESCAPING!' 38
        hotkey 'Cancel Current Target'
        hotkey '> Interrupt'
        whisper '[recall Guild Hall'
        removelist 'nox_single'
        if listexists 'f_leytry'
            removelist 'f_leytry'
        endif
        stop
    endif

    if listexists 'cfg_escape' and skill 'Tracking' >= 80 and not findbuff 'Tracking' and timer 'tracktry' >= 10000
        settimer 'tracktry' 0
        if gumpexists 4267467659
            gumpclose 4267467659
        endif
        useskill 'Tracking'
        waitforgump 4267467659 2000
        gumpresponse TrackButton 4267467659
        wait 500
        if gumpexists 4267467659
            gumpresponse 6 4267467659
        endif
        wait 500
    endif

    // ===== 4. Defensive =====
    @setvar! HealFailed 0
    if diffhits >= HealPotDiff and timer 'healpot' >= 10000 and findtype 3852 self
        dclicktype 3852
        settimer 'healpot' 0
        wait 200
    endif

    if poisoned and timer 'curepot' >= 2000
        if findtype 3847 self
            dclicktype 3847
            settimer 'curepot' 0
            wait 200
        elseif mana >= 6 and findtype 3972 self and findtype 3973 self
            // Wait for a running cast to finish and drop any stray cursor,
            // so 'target self' can only ever answer this heal/cure
            for 25
                if not casting
                    break
                endif
                wait 100
            endfor
            if targetexists
                hotkey 'Cancel Current Target'
                wait 100
            endif
            cast 'Cure'
            // Wait for the cursor, but stop at once if the cast was refused
            for 20
                if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                    break
                endif
                wait 100
            endfor
            if targetexists
                target 'self'
                settimer 'curepot' 0
            else
                // Refused (still recovering): no attack spells this pass,
                // the next pass tries the cure again first
                @setvar! HealFailed 1
            endif
        endif
    endif

    if diffhits >= GreaterHealDiff and mana >= 11 and timer 'gheal' >= 2500 and findtype 3972 self and findtype 3973 self and findtype 3974 self and findtype 3981 self
        // Wait for a running cast to finish and drop any stray cursor,
        // so 'target self' can only ever answer this heal/cure
        for 25
            if not casting
                break
            endif
            wait 100
        endfor
        if targetexists
            hotkey 'Cancel Current Target'
            wait 100
        endif
        cast 'Greater Heal'
        // Wait for the cursor, but stop at once if the cast was refused
        for 25
            if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                break
            endif
            wait 100
        endfor
        if targetexists
            target 'self'
            // Only start the timer when the heal really went off
            settimer 'gheal' 0
        else
            // Refused (still recovering): no attack spells this pass,
            // the next pass tries the heal again first
            @setvar! HealFailed 1
        endif
    endif

    if mana < 50 and timer 'mushroom' >= 60000
        if timer 'mushtry' >= 3000
            dclicktype 29012
            settimer 'mushtry' 0
            wait 200
        endif
    endif

    // Potion buffs. Not spells, so they never block a cast.
    // A drink that gives no buff is retried 5 s later.
    if UseStrPot = 1 and not findbuff 'Strength' and timer 'strpot' >= 5000 and findtype 3849 self
        dclicktype 3849
        settimer 'strpot' 0
        wait 200
    endif
    if UseAgiPot = 1 and not findbuff 'Agility' and timer 'agipot' >= 5000 and findtype 3848 self
        dclicktype 3848
        settimer 'agipot' 0
        wait 200
    endif
    if UseResistPot = 1 and not findbuff 'Greater Magic Resist Potion' and not findbuff 'Magic Resist Potion' and timer 'resistpot' >= 5000 and findtype 3846 self
        dclicktype 3846
        settimer 'resistpot' 0
        wait 200
    endif

    // Buff spells: pick the first missing one, it is cast in the combat part.
    // Each needs mana for itself plus a Greater Heal (11) afterwards.
    @setvar! BuffSpell 0
    if HealFailed = 0 and diffhits < GreaterHealDiff and mana >= KeepMana
        if UseProtection = 1 and not findbuff 'Protection' and timer 'protry' >= 3000 and mana >= 17 and findtype 3972 self and findtype 3973 self and findtype 3980 self
            @setvar! BuffSpell 1
        elseif UseReactiveArmor = 1 and not findbuff 'Reactive Armor' and timer 'ratry' >= 3000 and mana >= 15 and findtype 3972 self and findtype 3980 self and findtype 3981 self
            @setvar! BuffSpell 2
        elseif UseMagicReflect = 1 and not findbuff 'Magic Reflection' and timer 'reflecttry' >= 3000 and mana >= 25 and findtype 3972 self and findtype 3974 self and findtype 3981 self
            @setvar! BuffSpell 3
        elseif UseCunning = 1 and not findbuff 'Cunning' and timer 'cuntry' >= 3000 and mana >= 15 and findtype 3974 self and findtype 3976 self
            @setvar! BuffSpell 4
        endif
    endif

    // ===== 5. Target still alive? =====
    @setvar! HaveTarget 1
    if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
        @setvar! HaveTarget 0
        if AutoNext = 0
            overhead 'Target gone - stopped' 53
            removelist 'nox_single'
            stop
        endif
        hotkey 'Target Closest Grey Monster'
        wait 150
        if insysmsg 'No one matching'
            overhead 'Target gone - nothing nearby' 53
            removelist 'nox_single'
            stop
        endif
        @setvar! noxCand lasttarget
        getlabel noxCand candLabel
        if find noxCand ground -1 -1 0
            // that's us - never a target
        elseif "tame" in candLabel or "summoned" in candLabel
            @ignore noxCand
        else
            @setvar! noxMain noxCand
            @setvar! HaveTarget 1
            settimer 'lethalseen' 0
            attack noxMain
            settimer 'attackref' 0
            if followers > 0
                say 'All kill'
                waitfortarget 1500
                if targetexists
                    target noxMain
                endif
            endif
            overhead '[ NEW TARGET ]' 68 noxMain
        endif
    endif

    // ===== 6. Combat =====
    if HaveTarget = 1
        if timer 'attackref' >= 3000
            attack noxMain
            settimer 'attackref' 0
        endif

        // Leyline on cooldown. Not a spell, so it never blocks a cast.
        if UseLeyline = 1 and timer 'leyline' >= LeylineCD and timer 'leytry' >= 3000
            say '[WeaponAbility2'
            settimer 'leytry' 0
            if not listexists 'f_leytry'
                createlist 'f_leytry'
            endif
            wait 100
            attack noxMain
        endif

        // Explosion potion every 15 seconds (only with Alchemy >= 80)
        if skill 'Alchemy' >= 80 and timer 'explo' >= 15000 and findtype 3853 self
            if targetexists
                hotkey 'Cancel Current Target'
                wait 100
            endif
            dclicktype 3853
            waitfortarget 2000
            if targetexists
                target noxMain
            endif
            settimer 'explo' 0
            wait 200
        endif

        // Poison state from the target's label
        getlabel noxMain noxLabel
        if "-" in noxLabel
            wait 100
            getlabel noxMain noxLabel
        endif
        @setvar! NeedPoison 1
        if "Lethal" in noxLabel
            @setvar! NeedPoison 0
        elseif NoxLevel = 1 and "Deadly" in noxLabel
            @setvar! NeedPoison 0
        endif
        if NeedPoison = 0
            settimer 'lethalseen' 0
        endif

        // A heal or cure was refused: skip all attack spells this pass
        @setvar! Acted 0
        if HealFailed = 1
            @setvar! Acted 1
        endif

        // a) Keep the poison up. Poison is cast back to back until the label
        //    shows the wanted level (one extra cast after it lands is fine).
        //    If it never gets there (immune / resisting target), back off to
        //    one Poison every 5 s so the other spells still get cast.
        if Acted = 0 and NeedPoison = 1 and mana >= 9 and mana >= KeepMana and findtype 3976 self
            if timer 'lethalseen' < 8000 or timer 'poisontry' >= 5000
                cast 'Poison'
                // Wait for the cursor, but stop at once if the cast was refused
                for 25
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target noxMain
                    settimer 'poisontry' 0
                else
                    // Refused (still recovering): short pause, then try again
                    wait 100
                endif
                @setvar! Acted 1
            endif
        endif

        // b) Buff spells (Protection, Reactive Armor, Magic Reflection, Cunning)
        if Acted = 0 and BuffSpell > 0
            if BuffSpell = 1
                cast 'Protection'
                settimer 'protry' 0
            elseif BuffSpell = 2
                cast 'Reactive Armor'
                settimer 'ratry' 0
            elseif BuffSpell = 3
                cast 'Magic Reflection'
                settimer 'reflecttry' 0
            else
                cast 'Cunning'
                settimer 'cuntry' 0
                // Wait for the cursor, but stop at once if the cast was refused
                for 20
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target 'self'
                endif
            endif
            // Let the cast finish, so the next spell isn't refused
            wait 300
            for 30
                if not casting
                    break
                endif
                wait 100
            endfor
            @setvar! Acted 1
        endif

        // c) Poison Strike when few ticks are left
        //    Shares the 1 s gap with the necro debuffs, so they don't block each other
        if Acted = 0 and skill 'Necromancy' >= 55 and timer 'pstrike' >= 30000 and timer 'necrogap' >= 1000 and "Ticks" in noxLabel
            @setvar! StrikeNow 0
            if "[2" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 3 and "[3" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 4 and "[4" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 5 and "[5" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 6 and "[6" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 7 and "[7" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 8 and "[8" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 9 and "[9" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeNow = 1
                say '[PoisonStrike'
                waitfortarget 1500
                if targetexists
                    target noxMain
                endif
                // Wait up to 1 s for the server's answer.
                // Only "unholy symbols remaining" counts as a real hit.
                @setvar! StrikeResult 0
                for 10
                    if insysmsg 'nholy symbols remaining'
                        @setvar! StrikeResult 1
                        break
                    endif
                    if insysmsg 'seconds before you may use that ability again'
                        @setvar! StrikeResult 2
                        break
                    endif
                    if insysmsg 'do not have a Spell-based poison' or insysmsg 'another Necromancy ability'
                        @setvar! StrikeResult 3
                        break
                    endif
                    wait 100
                endfor
                if StrikeResult = 1
                    settimer 'pstrike' 0
                    overhead '[ POISON STRIKE ]' 77
                elseif StrikeResult = 2
                    // Still on cooldown: try again in 5 s
                    settimer 'pstrike' 25000
                else
                    // Blocked, no poison or no answer: try again in 2 s
                    settimer 'pstrike' 28000
                endif
                settimer 'necrogap' 0
                @setvar! Acted 1
            endif
        endif

        // d) Necro debuffs: one per pass, at least 1 s apart
        if Acted = 0 and timer 'necrogap' >= 1000 and mana >= 15
            if UseCorpseSkin = 1 and skill 'Necromancy' >= 65 and timer 'corpseskin' >= 30000
                say '[CorpseSkin'
                wait 250
                if insysmsg 'seconds before you may use that ability again'
                    settimer 'corpseskin' 25000
                else
                    settimer 'corpseskin' 0
                endif
                settimer 'necrogap' 0
                @setvar! Acted 1
            elseif UseMindRot = 1 and skill 'Necromancy' >= 75 and not findbuff 'Mind Rot' and timer 'mindrot' >= 30000
                say '[MindRot'
                wait 250
                if insysmsg 'seconds before you may use that ability again'
                    settimer 'mindrot' 25000
                else
                    settimer 'mindrot' 0
                endif
                settimer 'necrogap' 0
                @setvar! Acted 1
            elseif UseEvilOmen = 1 and skill 'Necromancy' >= 60 and timer 'evilomen' >= 30000
                say '[EvilOmen'
                wait 250
                if insysmsg 'seconds before you may use that ability again'
                    settimer 'evilomen' 25000
                else
                    settimer 'evilomen' 0
                endif
                settimer 'necrogap' 0
                @setvar! Acted 1
            elseif UseStrangle = 1 and skill 'Necromancy' >= 85 and mana >= 50 and timer 'strangle' >= 30000
                say '[Strangle'
                wait 250
                if insysmsg 'seconds before you may use that ability again'
                    settimer 'strangle' 25000
                else
                    settimer 'strangle' 0
                endif
                settimer 'necrogap' 0
                @setvar! Acted 1
            endif
        endif

        // e) Mana Drain once per new enemy, then every 60 s
        if Acted = 0
            if not inlist 'lastdrain' noxMain
                settimer 'manadrain' 99999
            endif
            if timer 'manadrain' >= 60000 and mana >= 11 and mana >= KeepMana and findtype 3962 self and findtype 3974 self and findtype 3981 self
                cast 'Mana Drain'
                // Wait for the cursor, but stop at once if the cast was refused
                for 20
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target noxMain
                    // Only start the timer when the cast really went off
                    settimer 'manadrain' 0
                    clearlist 'lastdrain'
                    pushlist 'lastdrain' noxMain
                endif
                @setvar! Acted 1
            endif
        endif

        // f) Damage spells, only with mana to spare
        if Acted = 0 and mana >= NukeMana
            if timer 'arrow' >= 15000 and findtype 3980 self
                cast 'Magic Arrow'
                // Wait for the cursor, but stop at once if the cast was refused
                for 20
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target noxMain
                    // Only start the timer when the cast really went off
                    settimer 'arrow' 0
                endif
            elseif timer 'lightning' >= 15000 and findtype 3974 self and findtype 3980 self
                cast 'Lightning'
                // Wait for the cursor, but stop at once if the cast was refused
                for 20
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target noxMain
                    // Only start the timer when the cast really went off
                    settimer 'lightning' 0
                endif
            elseif UseMindBlast = 1 and findtype 3962 self and findtype 3974 self and findtype 3976 self and findtype 3980 self
                cast 'Mind Blast'
                // Wait for the cursor, but stop at once if the cast was refused
                for 20
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target noxMain
                endif
            endif
        endif
    endif

    wait 100
endwhile

if listexists 'nox_single'
    removelist 'nox_single'
endif
if listexists 'f_leytry'
    removelist 'f_leytry'
endif
if listexists 'f_player'
    removelist 'f_player'
endif
overhead 'Single target stopped' 33
