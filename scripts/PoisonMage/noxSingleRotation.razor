// ==========================================================
// noxSingleRotation - mageSingleRotation plus the Nox logic
// (Poison, Poison Strike, necro debuffs) from Nox Single.
// Press the hotkey: a Poison cursor appears, click your enemy.
// Poison is then cast back to back until the wanted level lands.
// If your last target is still alive and in range, the script
// continues on it instead (no cursor). Press again to stop.
//
// Every pass: heals/cures/potions first. Then the first
// action whose conditions are met (one action per pass):
//   1. Mushroom below MushroomMana (does not count as the action)
//   2. Greater Explosion potion every 11.25 s (potion codex)
//   3. Curse every 58 s, and at once on a new target
//   4. Poison until the label shows NoxLevel (Deadly/Lethal)
//   5. Poison Strike when StrikeTicks or fewer ticks are left
//   6. Necro debuff (Corpse Skin, Mind Rot, Evil Omen, Strangle)
//   7. Lightning every 15 s (Grimoire proc)
//   8. Harm every 15 s (Grimoire proc)
//   9. Fireball every 15 s (Grimoire proc)
//  10. Magic Arrow every 15 s (Grimoire proc)
//  11. Filler spell when nothing else is due: Flamestrike (default),
//      Harm or Mind Blast (a Harm filler does not reset the Harm proc timer)
// Before the action: Leyline on cooldown at LeylineMana or less
// (not a spell, does not count as the action either)
// If the target vanishes (dead, hidden or invisible), the script keeps
// healing and waits LostGrace ms for it to come back before it looks
// for a new one.
// Every step except the mushroom can be switched off in the CONFIG.
// Soulfire, Catalyst and Mana Drain stay manual.
// Uses the same on/off list as Nox Single and mageSingleRotation, so
// only one of them runs at a time.
// ==========================================================

// ===== CONFIG =====
// Poison level: 1 = Deadly, 2 = Lethal
@setvar! NoxLevel 2
// 4. Keep the poison up (1 = on, 0 = off). Poison (9 mana) is not cast
// below KeepMana, so a Greater Heal (11) stays in reserve. 0 = off
@setvar! UsePoison 1
@setvar! KeepMana 22
// 5. Poison Strike when this many ticks or fewer are left (2 - 9)
// (1 = on, 0 = off)
@setvar! UsePoisonStrike 1
@setvar! StrikeTicks 7
// 6. Necro debuffs (1 = on, 0 = off), one per pass, at least 1 s apart
@setvar! UseCorpseSkin 1
@setvar! UseMindRot 1
@setvar! UseEvilOmen 0
@setvar! UseStrangle 0

// 1. Eat the magic mushroom below this mana (60 s cooldown)
@setvar! MushroomMana 75
// Leyline (Arcane weapon ability 2) on cooldown at this much mana or
// less (1 = on, 0 = off)
@setvar! UseLeyline 1
@setvar! LeylineMana 80
// Wait this long after Leyline went off before trying again (ms).
// 60000 comes from community scripts - CHECK IN-GAME: if your Leyline
// cooldown bar is shorter, lower this.
@setvar! LeylineCD 60000
// Leyline is armed by the command and only goes off (Leyline buff) when
// a staff hit lands. A second command would disarm it, so once armed
// the script leaves it alone for up to LeylineArmWait ms. Only if no buff
// shows up in that time is it armed again. A refused try (still on
// cooldown) is retried 3 s later.
@setvar! LeylineArmWait 15000
// 2. Greater Explosion potion every ExploEvery ms (1 = on, 0 = off).
// Set to 0 in groups if you're not sure they spare your friends.
// 11250 = 15 s base cooldown - 3.75 s from the potion codex
@setvar! UseExplo 1
@setvar! ExploEvery 11250
// 3. Curse every CurseEvery ms (1 = on, 0 = off)
@setvar! UseCurse 1
@setvar! CurseEvery 58000
// 7./8./9. Lightning, Harm and Fireball Grimoire procs every ProcEvery ms
// (1 = on, 0 = off)
@setvar! UseLightning 1
@setvar! UseHarm 1
@setvar! UseFireball 1
@setvar! ProcEvery 15000
// 10. Magic Arrow every MagicArrowEvery ms (1 = on, 0 = off), 4 mana
@setvar! UseMagicArrow 1
@setvar! MagicArrowEvery 15000
// 11. Filler spell, cast when nothing above is due:
//    1 = Flamestrike (default), 2 = Harm, 3 = Mind Blast, 0 = no filler
@setvar! FillerSpell 1
// Flamestrike filler: at FSMana or more, or at FSSoulfireMana while the
// Soulfire buff is active (Flamestrike costs 40)
@setvar! FSMana 51
@setvar! FSSoulfireMana 40
// Harm filler: at HarmFillerMana or more. 17 = Harm (6) + a Greater Heal
// (11) kept in reserve. Set to 6 to burn mana down to zero.
// Does not reset the Harm proc timer.
@setvar! HarmFillerMana 17
// Mind Blast filler: at MBFillerMana or more. 25 = Mind Blast (14) +
// a Greater Heal (11) kept in reserve. Set to 14 to burn mana to zero.
@setvar! MBFillerMana 25

// Heal thresholds (missing hit points)
@setvar! HealPotDiff 30
@setvar! GreaterHealDiff 30

// When the target dies: 1 = take the closest grey monster, 0 = stop
@setvar! AutoNext 1
// When the target vanishes, wait this long for it to come back (ms)
// before taking a new one (or stopping with AutoNext 0). Covers mobs
// that go hidden/invisible for a few seconds. The client can't tell a
// kill from a vanish, so this is also the pause after each kill before
// the next target is picked. 0 = old behaviour (switch at once).
@setvar! LostGrace 3000
// Stop when no valid target could be found for this long (ms),
// e.g. the closest monster is out of range or is a pet.
// Keep it larger than LostGrace.
@setvar! NoTargetStop 10000

// On start, continue on your last target if it is still alive and in
// range (1 = on, 0 = always ask with a Poison cursor)
@setvar! ResumeLastTarget 1

// ===== Toggle =====
// The multi target script can't be running at the same time
if listexists 'nox_multi'
    removelist 'nox_multi'
endif
if listexists 'nox_single'
    removelist 'nox_single'
    if targetexists
        hotkey 'Cancel Current Target'
    endif
    overhead 'Single target OFF' 33
    stop
endif
createlist 'nox_single'

// Leyline may still be armed from a previous run, so the armed flag
// is kept. LeylineArmWait clears it if no hit ever lands.

// Drop a cursor left over from a previous run
if targetexists
    hotkey 'Cancel Current Target'
    wait 100
endif

// Remembers which enemy was cursed last (Curse is due at once on a new
// one). Kept between runs, so a restart on the same enemy doesn't curse
// it again before CurseEvery is up.
if not listexists 'rcursed'
    createlist 'rcursed'
endif

// ===== Timers (99999 = ready immediately) =====
if not timerexists 'healpot'
    createtimer 'healpot'
    settimer 'healpot' 99999
endif
if not timerexists 'curepot'
    createtimer 'curepot'
    settimer 'curepot' 99999
endif
if not timerexists 'gheal'
    createtimer 'gheal'
    settimer 'gheal' 99999
endif
if not timerexists 'attackref'
    createtimer 'attackref'
    settimer 'attackref' 99999
endif
// Time since the script last had a valid target
if not timerexists 'rnotarget'
    createtimer 'rnotarget'
endif
// Time since the current enemy was last seen (grace for hidden mobs)
if not timerexists 'rlost'
    createtimer 'rlost'
endif
// Throttles the search for a new target to once per second
if not timerexists 'rsearch'
    createtimer 'rsearch'
    settimer 'rsearch' 99999
endif
// Rotation timers, each reset when its action starts
if not timerexists 'leyline'
    createtimer 'leyline'
    settimer 'leyline' 99999
endif
if not timerexists 'leytry'
    createtimer 'leytry'
    settimer 'leytry' 99999
endif
// Time since Leyline was armed
if not timerexists 'leyarm'
    createtimer 'leyarm'
    settimer 'leyarm' 99999
endif
if not timerexists 'rmushroom'
    createtimer 'rmushroom'
    settimer 'rmushroom' 99999
endif
if not timerexists 'rexplo'
    createtimer 'rexplo'
    settimer 'rexplo' 99999
endif
// Kept between runs too (see 'rcursed' above)
if not timerexists 'rcurse'
    createtimer 'rcurse'
    settimer 'rcurse' 999999
endif
if not timerexists 'rlightning'
    createtimer 'rlightning'
    settimer 'rlightning' 99999
endif
if not timerexists 'rharm'
    createtimer 'rharm'
    settimer 'rharm' 99999
endif
if not timerexists 'rfireball'
    createtimer 'rfireball'
    settimer 'rfireball' 99999
endif
if not timerexists 'rmagicarrow'
    createtimer 'rmagicarrow'
    settimer 'rmagicarrow' 99999
endif
// Nox timers, same names as in Nox Single (same cooldowns in game)
if not timerexists 'poisontry'
    createtimer 'poisontry'
    settimer 'poisontry' 99999
endif
// Time since the label last showed the wanted poison level
if not timerexists 'lethalseen'
    createtimer 'lethalseen'
    settimer 'lethalseen' 0
endif
if not timerexists 'pstrike'
    createtimer 'pstrike'
    settimer 'pstrike' 99999
endif
if not timerexists 'corpseskin'
    createtimer 'corpseskin'
    settimer 'corpseskin' 99999
endif
if not timerexists 'mindrot'
    createtimer 'mindrot'
    settimer 'mindrot' 99999
endif
if not timerexists 'evilomen'
    createtimer 'evilomen'
    settimer 'evilomen' 99999
endif
if not timerexists 'strangle'
    createtimer 'strangle'
    settimer 'strangle' 99999
endif
// Shared 1 s gap between necro abilities
if not timerexists 'necrogap'
    createtimer 'necrogap'
    settimer 'necrogap' 99999
endif

// ==========================================================
// PHASE 1: pick the target (last target, or the first Poison cast)
// ==========================================================
@setvar! NoxLanded 0
@setvar! NoxAbort 0
@setvar! NoxResume 0

// The enemy lives in its own variable, so other target hotkeys can't move it.
// Last target still alive and in range? Then continue on it.
if ResumeLastTarget = 1
    @setvar! noxCand lasttarget
    if find noxCand ground -1 -1 12
        if dead noxCand or find noxCand ground -1 -1 0
            // dead, or that's us
        else
            getlabel noxCand candLabel
            if "tame" in candLabel or "summoned" in candLabel
                // own pet - ask for a new enemy
            else
                @setvar! noxMain noxCand
                @setvar! NoxResume 1
            endif
        endif
    endif
endif

if NoxResume = 1
    if queued
        hotkey 'Clear Target Queue'
    endif
    clearsysmsg
    overhead '[ CONTINUE ]' 68 noxMain
else
    if mana < 9
        overhead 'Not enough mana!' 33
        removelist 'nox_single'
        stop
    endif

    // A Last Target pressed while no cursor was open is queued by Razor and
    // would grab our next cursor, sending the spell to the old target
    if queued
        hotkey 'Clear Target Queue'
    endif
    overhead 'Select enemy' 68
    clearsysmsg
    // The first Poison cast picks the enemy: click it with the cursor
    cast 'Poison'
    waitfortarget 3000
    if not targetexists
        overhead 'Cast did not start - try again' 33
        removelist 'nox_single'
        stop
    endif
    while targetexists
        wait 50
    endwhile

    @setvar! noxMain lasttarget

    if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
        overhead 'No valid target' 33
        removelist 'nox_single'
        stop
    endif
endif

warmode on
attack noxMain
settimer 'attackref' 0
if followers > 0
    say 'All kill'
    waitfortarget 1500
    if targetexists
        target noxMain
    endif
endif

// Fast opening: Poison back to back until the label shows the wanted level.
// No waiting for each result - one extra cast after it lands is fine.
for 12
    if UsePoison = 0
        break
    endif
    // Quick check of the result so far: journal AND target label
    getlabel noxMain noxLabel
    if "Lethal" in noxLabel
        @setvar! NoxLanded 1
    elseif NoxLevel = 1 and "Deadly" in noxLabel
        @setvar! NoxLanded 1
    endif
    if insysmsg 'upgraded to lethal'
        @setvar! NoxLanded 1
    endif
    if NoxLevel = 1 and insysmsg 'upgraded to deadly'
        @setvar! NoxLanded 1
    endif
    if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
        @setvar! NoxAbort 1
    endif
    if insysmsg 'cannot be seen' or insysmsg 'too far away'
        @setvar! NoxAbort 1
    endif
    if NoxLanded = 1 or NoxAbort = 1
        break
    endif
    if mana < 9
        break
    endif
    // Heal potion also during the opening
    if diffhits >= HealPotDiff and timer 'healpot' >= 10000 and findtype 3852 self
        dclicktype 3852
        settimer 'healpot' 0
        wait 200
    endif
    // Don't keep casting while badly hurt - the rotation heals first
    if diffhits >= GreaterHealDiff
        break
    endif

    if queued
        hotkey 'Clear Target Queue'
    endif
    clearsysmsg
    cast 'Poison'
    for 40
        if targetexists
            break
        endif
        if insysmsg 'upgraded to lethal'
            @setvar! NoxLanded 1
            break
        endif
        if NoxLevel = 1 and insysmsg 'upgraded to deadly'
            @setvar! NoxLanded 1
            break
        endif
        if insysmsg 'recovered' or insysmsg 'already casting'
            break
        endif
        wait 50
    endfor
    if NoxLanded = 1
        break
    endif
    if targetexists
        if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
            @setvar! NoxAbort 1
            break
        endif
        target noxMain
    else
        // Refused (still recovering): short pause, then try again
        wait 100
    endif
endfor

if targetexists
    hotkey 'Cancel Current Target'
endif
if NoxLanded = 1
    overhead 'Poison landed!' 68
endif

// ==========================================================
// PHASE 2: rotation
// ==========================================================
overhead 'Rotating !' 68
clearsysmsg
settimer 'rnotarget' 0
settimer 'rlost' 0
settimer 'lethalseen' 0

while listexists 'nox_single' and not dead

    // ===== 1. Clear the journal =====
    // Armed Leyline went off (a staff hit landed)? Then its cooldown
    // starts. No hit within LeylineArmWait: forget it, so it is armed again.
    if listexists 'f_leyarmed'
        if findbuff 'Leyline'
            removelist 'f_leyarmed'
            settimer 'leyline' 0
        elseif timer 'leyarm' >= LeylineArmWait
            removelist 'f_leyarmed'
        endif
    endif
    clearsysmsg

    // A stray cursor must never be used by a self-target spell
    if targetexists
        hotkey 'Cancel Current Target'
        wait 100
    endif
    // A Last Target pressed while no cursor was open is queued by Razor and
    // would grab our next cursor, sending the spell to the old target
    if queued
        hotkey 'Clear Target Queue'
    endif

    // ===== 2. Defensive =====
    @setvar! HealFailed 0
    if diffhits >= HealPotDiff and timer 'healpot' >= 10000 and findtype 3852 self
        dclicktype 3852
        settimer 'healpot' 0
        wait 200
    endif

    if poisoned and timer 'curepot' >= 2000
        if findtype 3847 self
            dclicktype 3847
            settimer 'curepot' 0
            wait 200
        elseif mana >= 6
            // Wait for a running cast to finish and drop any stray cursor,
            // so 'target self' can only ever answer this heal/cure
            for 25
                if not casting
                    break
                endif
                wait 100
            endfor
            if targetexists
                hotkey 'Cancel Current Target'
                wait 100
            endif
            cast 'Cure'
            // Wait for the cursor, but stop at once if the cast was refused
            for 20
                if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                    break
                endif
                wait 100
            endfor
            if targetexists
                target 'self'
                settimer 'curepot' 0
            else
                // Refused (still recovering): no attack spells this pass,
                // the next pass tries the cure again first
                @setvar! HealFailed 1
            endif
        endif
    endif

    if diffhits >= GreaterHealDiff and mana >= 11 and timer 'gheal' >= 2500
        // Wait for a running cast to finish and drop any stray cursor,
        // so 'target self' can only ever answer this heal/cure
        for 25
            if not casting
                break
            endif
            wait 100
        endfor
        if targetexists
            hotkey 'Cancel Current Target'
            wait 100
        endif
        cast 'Greater Heal'
        // Wait for the cursor, but stop at once if the cast was refused
        for 25
            if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                break
            endif
            wait 100
        endfor
        if targetexists
            target 'self'
            // Only start the timer when the heal really went off
            settimer 'gheal' 0
        else
            // Refused (still recovering): no attack spells this pass,
            // the next pass tries the heal again first
            @setvar! HealFailed 1
        endif
    endif

    // ===== 3. Target still alive? =====
    // A hidden/invisible mob is removed from your client, so it looks
    // exactly like a dead one. Every pass checks noxMain again first, so
    // if it reappears within the grace time the rotation just carries on.
    @setvar! HaveTarget 1
    if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
        @setvar! HaveTarget 0
    endif

    if HaveTarget = 1
        settimer 'rlost' 0
    elseif timer 'rlost' < LostGrace
        // Just vanished: keep healing, wait for it to come back
    elseif AutoNext = 0
        overhead 'Target gone - stopped' 53
        removelist 'nox_single'
        stop
    elseif timer 'rsearch' >= 1000
        settimer 'rsearch' 0
        hotkey 'Target Closest Grey Monster'
        wait 150
        if insysmsg 'No one matching'
            // Nothing nearby (yet): keep looking, NoTargetStop ends the
            // script if nothing turns up. noxMain is still checked every
            // pass, so a mob that reappears late is taken up again.
        else
            @setvar! noxCand lasttarget
            getlabel noxCand candLabel
            if find noxCand ground -1 -1 0
                // that's us - never a target
            elseif "tame" in candLabel or "summoned" in candLabel
                @ignore noxCand
            elseif not find noxCand ground -1 -1 12
                // Closest monster is on screen but out of range: don't take it,
                // or it would be dropped again next pass and picked again
                // (Curse, 'All kill' and the overhead every pass)
            else
                @setvar! noxMain noxCand
                @setvar! HaveTarget 1
                settimer 'rlost' 0
                // New enemy: Curse is due at once, proc timers keep running.
                // Poison is chained back to back again until it lands.
                settimer 'rcurse' 999999
                settimer 'lethalseen' 0
                attack noxMain
                settimer 'attackref' 0
                if followers > 0
                    say 'All kill'
                    waitfortarget 1500
                    if targetexists
                        target noxMain
                    endif
                endif
                overhead '[ NEW TARGET ]' 68 noxMain
            endif
        endif
    endif

    // No usable target for too long (out of range, pets only...): stop
    // instead of looping on the target hotkey forever
    if HaveTarget = 1
        settimer 'rnotarget' 0
    elseif timer 'rnotarget' >= NoTargetStop
        overhead 'No target in range - stopped' 53
        removelist 'nox_single'
        stop
    endif

    // ===== 4. Rotation =====
    if HaveTarget = 1
        if timer 'attackref' >= 3000
            attack noxMain
            settimer 'attackref' 0
        endif

        // 1. Mushroom: not the action for this pass, the list goes on
        if mana < MushroomMana and timer 'rmushroom' >= 60000 and findtype 29012 self
            dclicktype 29012
            settimer 'rmushroom' 0
            wait 200
        endif

        // Arm Leyline at LeylineMana or less. Never while its buff is up
        // or while it is already armed (a second command would disarm it).
        // Runs before the action, so it is armed on the first pass below
        // LeylineMana. Not a spell, so it never blocks a cast.
        if UseLeyline = 1 and mana <= LeylineMana and not findbuff 'Leyline' and not listexists 'f_leyarmed' and timer 'leyline' >= LeylineCD and timer 'leytry' >= 3000
            clearsysmsg
            say '[WeaponAbility2'
            settimer 'leytry' 0
            // Give a refusal time to reach the journal
            wait 300
            if not insysmsg 'cannot perform that ability yet'
                // No refusal: armed, wait for a staff hit to land
                createlist 'f_leyarmed'
                settimer 'leyarm' 0
            endif
            attack noxMain
        endif

        // Is Curse due? Every CurseEvery, or at once on a new target
        @setvar! CurseDue 0
        if timer 'rcurse' >= CurseEvery
            @setvar! CurseDue 1
        elseif not inlist 'rcursed' noxMain
            @setvar! CurseDue 1
        endif
        // Poison state from the target's label
        getlabel noxMain noxLabel
        if "-" in noxLabel
            wait 100
            getlabel noxMain noxLabel
        endif
        @setvar! NeedPoison 1
        if "Lethal" in noxLabel
            @setvar! NeedPoison 0
        elseif NoxLevel = 1 and "Deadly" in noxLabel
            @setvar! NeedPoison 0
        endif
        if NeedPoison = 0
            settimer 'lethalseen' 0
        endif
        // Is Poison due? Back to back until the label shows the wanted
        // level. If it never gets there (immune / resisting target), back
        // off to one Poison every 5 s so the other steps still get cast.
        @setvar! PoisonDue 0
        if UsePoison = 1 and NeedPoison = 1 and mana >= 9 and mana >= KeepMana
            if timer 'lethalseen' < 8000 or timer 'poisontry' >= 5000
                @setvar! PoisonDue 1
            endif
        endif
        // Is Poison Strike due? Only when few ticks are left. Shares the
        // 1 s gap with the necro debuffs, so they don't block each other.
        @setvar! StrikeNow 0
        if UsePoisonStrike = 1 and skill 'Necromancy' >= 55 and timer 'pstrike' >= 30000 and timer 'necrogap' >= 1000 and "Ticks" in noxLabel
            if "[2" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 3 and "[3" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 4 and "[4" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 5 and "[5" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 6 and "[6" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 7 and "[7" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 8 and "[8" in noxLabel
                @setvar! StrikeNow 1
            endif
            if StrikeTicks >= 9 and "[9" in noxLabel
                @setvar! StrikeNow 1
            endif
        endif
        // Which necro debuff is due? 0 = none
        @setvar! NecroSpell 0
        if timer 'necrogap' >= 1000 and mana >= 15
            if UseCorpseSkin = 1 and skill 'Necromancy' >= 65 and timer 'corpseskin' >= 30000
                @setvar! NecroSpell 1
            elseif UseMindRot = 1 and skill 'Necromancy' >= 75 and not findbuff 'Mind Rot' and timer 'mindrot' >= 30000
                @setvar! NecroSpell 2
            elseif UseEvilOmen = 1 and skill 'Necromancy' >= 60 and timer 'evilomen' >= 30000
                @setvar! NecroSpell 3
            elseif UseStrangle = 1 and skill 'Necromancy' >= 85 and mana >= 50 and timer 'strangle' >= 30000
                @setvar! NecroSpell 4
            endif
        endif

        // Is the chosen filler castable? Flamestrike needs less mana
        // while Soulfire is up
        @setvar! FillerOk 0
        if FillerSpell = 1
            if mana >= FSMana
                @setvar! FillerOk 1
            elseif findbuff 'Soulfire' and mana >= FSSoulfireMana
                @setvar! FillerOk 1
            endif
        elseif FillerSpell = 2
            if mana >= HarmFillerMana
                @setvar! FillerOk 1
            endif
        elseif FillerSpell = 3
            if mana >= MBFillerMana
                @setvar! FillerOk 1
            endif
        endif

        // A refused heal or cure means no action this pass
        if HealFailed = 0
            // Never start a rotation action while a cast or a cursor (also
            // the explosion potion's) is still active: wait for the cast
            // to finish, then drop a stray cursor and any queued target
            for 25
                if not casting
                    break
                endif
                wait 100
            endfor
            if targetexists
                hotkey 'Cancel Current Target'
                wait 100
            endif
            if queued
                hotkey 'Clear Target Queue'
            endif

            // 2. Greater Explosion potion on the target
            if UseExplo = 1 and timer 'rexplo' >= ExploEvery and findtype 3853 self
                dclicktype 3853
                settimer 'rexplo' 0
                waitfortarget 2000
                if targetexists
                    target noxMain
                endif
                wait 200
                // The potion's cursor must be closed before anything else
                if targetexists
                    hotkey 'Cancel Current Target'
                    wait 100
                endif

            // 3. Curse: due every CurseEvery, or at once on a new target.
            // 11 mana
            elseif UseCurse = 1 and CurseDue = 1 and mana >= 11
                clearsysmsg
                cast 'Curse'
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    // Reset now, so a failed targeting can't repeat this spell
                    settimer 'rcurse' 0
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                        // Only a really answered cursor counts as cursed
                        clearlist 'rcursed'
                        pushlist 'rcursed' noxMain
                    endif
                endif

            // 4. Poison, 9 mana. Chained back to back: no wait for the result
            elseif PoisonDue = 1
                clearsysmsg
                cast 'Poison'
                // Wait for the cursor, but stop at once if the cast was refused
                for 25
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target noxMain
                    settimer 'poisontry' 0
                else
                    // Refused (still recovering): short pause, then try again
                    wait 100
                endif

            // 5. Poison Strike. Only "unholy symbols remaining" counts as a hit
            elseif StrikeNow = 1
                clearsysmsg
                say '[PoisonStrike'
                waitfortarget 1500
                if targetexists
                    target noxMain
                endif
                // Wait up to 1 s for the server's answer
                @setvar! StrikeResult 0
                for 10
                    if insysmsg 'nholy symbols remaining'
                        @setvar! StrikeResult 1
                        break
                    endif
                    if insysmsg 'seconds before you may use that ability again'
                        @setvar! StrikeResult 2
                        break
                    endif
                    if insysmsg 'do not have a Spell-based poison' or insysmsg 'another Necromancy ability'
                        @setvar! StrikeResult 3
                        break
                    endif
                    wait 100
                endfor
                if StrikeResult = 1
                    settimer 'pstrike' 0
                    overhead '[ POISON STRIKE ]' 77
                elseif StrikeResult = 2
                    // Still on cooldown: try again in 5 s
                    settimer 'pstrike' 25000
                else
                    // Blocked, no poison or no answer: try again in 2 s
                    settimer 'pstrike' 28000
                endif
                settimer 'necrogap' 0

            // 6. Necro debuff, one per pass
            elseif NecroSpell > 0
                clearsysmsg
                if NecroSpell = 1
                    say '[CorpseSkin'
                    wait 250
                    if insysmsg 'seconds before you may use that ability again'
                        settimer 'corpseskin' 25000
                    else
                        settimer 'corpseskin' 0
                    endif
                elseif NecroSpell = 2
                    say '[MindRot'
                    wait 250
                    if insysmsg 'seconds before you may use that ability again'
                        settimer 'mindrot' 25000
                    else
                        settimer 'mindrot' 0
                    endif
                elseif NecroSpell = 3
                    say '[EvilOmen'
                    wait 250
                    if insysmsg 'seconds before you may use that ability again'
                        settimer 'evilomen' 25000
                    else
                        settimer 'evilomen' 0
                    endif
                else
                    say '[Strangle'
                    wait 250
                    if insysmsg 'seconds before you may use that ability again'
                        settimer 'strangle' 25000
                    else
                        settimer 'strangle' 0
                    endif
                endif
                settimer 'necrogap' 0

            // 7. Lightning proc, 11 mana
            elseif UseLightning = 1 and timer 'rlightning' >= ProcEvery and mana >= 11
                clearsysmsg
                cast 'Lightning'
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    // Reset now, so a failed targeting can't repeat this spell
                    settimer 'rlightning' 0
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                    endif
                endif

            // 8. Harm proc, 6 mana
            elseif UseHarm = 1 and timer 'rharm' >= ProcEvery and mana >= 6
                clearsysmsg
                cast 'Harm'
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    // Reset now, so a failed targeting can't repeat this spell
                    settimer 'rharm' 0
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                    endif
                endif

            // 9. Fireball proc, 9 mana
            elseif UseFireball = 1 and timer 'rfireball' >= ProcEvery and mana >= 9
                clearsysmsg
                cast 'Fireball'
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    // Reset now, so a failed targeting can't repeat this spell
                    settimer 'rfireball' 0
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                    endif
                endif

            // 10. Magic Arrow, 4 mana
            elseif UseMagicArrow = 1 and timer 'rmagicarrow' >= MagicArrowEvery and mana >= 4
                clearsysmsg
                cast 'Magic Arrow'
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    // Reset now, so a failed targeting can't repeat this spell
                    settimer 'rmagicarrow' 0
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                    endif
                endif

            // 11. Filler: Flamestrike, Harm or Mind Blast (see FillerSpell).
            // No timer is reset, so a Harm filler doesn't touch the Harm proc
            elseif FillerOk = 1
                clearsysmsg
                if FillerSpell = 1
                    cast 'Flamestrike'
                elseif FillerSpell = 2
                    cast 'Harm'
                else
                    cast 'Mind Blast'
                endif
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                    endif
                endif
            endif
        endif
    endif

    wait 100
endwhile

if listexists 'nox_single'
    removelist 'nox_single'
endif
overhead 'Single target stopped' 33
