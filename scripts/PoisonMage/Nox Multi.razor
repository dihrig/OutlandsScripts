// ==========================================================
// Nox Multi - poison everything in range
// Press the hotkey to start, again to stop.
//
// Every pass it cycles through the grey monsters nearby.
// Priority: 1. poison unpoisoned mobs
//           2. Poison Strike on a mob with few ticks left
//           3. upcast poisoned mobs to Lethal
// Pets are sent at one mob at a time.
// Leyline is used on cooldown while mobs are in range.
// Note: the scan has to cycle your target highlight - that
// is the only way Razor can read a mob's poison state.
// ==========================================================

// ===== CONFIG =====
// Escape on enemy players via Tracking.
// To DISABLE: put // in front of the createlist line below.
if listexists 'cfg_escape'
    removelist 'cfg_escape'
endif
//createlist 'cfg_escape'

// Tracking gump button: 7 = Players, 8 = hostile players only
@setvar! TrackButton 7

// Unpoisoned mobs always come first. Once every mob in range carries
// poison, upcast the weaker ones to Lethal (1 = on, 0 = off)
@setvar! UpcastLethal 1

// Only mobs within this many tiles (max 12 for spells)
@setvar! ScanRange 10

// Poison Strike on mobs with this many ticks or fewer left (2 - 9), 0 = off
@setvar! StrikeTicks 7

// Mind Rot (1 = on, 0 = off)
@setvar! UseMindRot 1

// Send summons at one mob at a time (1 = on, 0 = off)
@setvar! PetsAttack 1

// Leyline (Arcane weapon ability 2) on cooldown (1 = on, 0 = off)
@setvar! UseLeyline 1
// Wait this long after Leyline went off before trying again (ms).
// 60000 comes from community scripts - CHECK IN-GAME: if your Leyline
// cooldown bar is shorter, lower this. A try that is still on cooldown
// is simply retried 3 s later.
@setvar! LeylineCD 60000

// Heal thresholds (missing hit points)
@setvar! HealPotDiff 30
@setvar! GreaterHealDiff 30
// Poison is not cast below this much mana, so
// there is always enough left for a Greater Heal (11). 0 = off
@setvar! KeepMana 22

// ===== Toggle =====
// The single target script can't be running at the same time
if listexists 'nox_single'
    removelist 'nox_single'
endif
if listexists 'nox_multi'
    removelist 'nox_multi'
    if targetexists
        hotkey 'Cancel Current Target'
    endif
    overhead 'Multi target OFF' 33
    stop
endif
createlist 'nox_multi'

if listexists 'f_player'
    removelist 'f_player'
endif
if listexists 'f_leytry'
    removelist 'f_leytry'
endif
if targetexists
    hotkey 'Cancel Current Target'
    wait 100
endif
// A Last Target pressed while no cursor was open is queued by Razor and
// would grab our next cursor, sending the spell to the old target
if queued
    hotkey 'Clear Target Queue'
endif
clearsysmsg

if listexists 'cfg_escape'
    overhead 'Poisoning everything ! (escape ON)' 68
endif
if not listexists 'cfg_escape'
    overhead 'Poisoning everything ! (escape OFF)' 68
endif

warmode on
@setvar! petTarget 0

// ===== Timers (99999 = ready immediately) =====
if not timerexists 'healpot'
    createtimer 'healpot'
    settimer 'healpot' 99999
endif
if not timerexists 'curepot'
    createtimer 'curepot'
    settimer 'curepot' 99999
endif
if not timerexists 'gheal'
    createtimer 'gheal'
    settimer 'gheal' 99999
endif
if not timerexists 'mushroom'
    createtimer 'mushroom'
    settimer 'mushroom' 99999
endif
if not timerexists 'mushtry'
    createtimer 'mushtry'
    settimer 'mushtry' 99999
endif
if not timerexists 'tracktry'
    createtimer 'tracktry'
    settimer 'tracktry' 99999
endif
if not timerexists 'pstrike'
    createtimer 'pstrike'
    settimer 'pstrike' 99999
endif
if not timerexists 'mindrot'
    createtimer 'mindrot'
    settimer 'mindrot' 99999
endif
if not timerexists 'necrogap'
    createtimer 'necrogap'
    settimer 'necrogap' 99999
endif
if not timerexists 'leyline'
    createtimer 'leyline'
    settimer 'leyline' 99999
endif
if not timerexists 'leytry'
    createtimer 'leytry'
    settimer 'leytry' 99999
endif
if not timerexists 'idlemsg'
    createtimer 'idlemsg'
    settimer 'idlemsg' 99999
endif

while listexists 'nox_multi' and not dead

    // ===== 1. Read the journal into flags =====
    if listexists 'cfg_escape' and insysmsg ' spaces'
        if not listexists 'f_player'
            createlist 'f_player'
        endif
    endif
    if insysmsg 'consume a magic mushroom'
        settimer 'mushroom' 0
    endif
    // Did the last Leyline try go off? Refused = still on cooldown, retry in 3 s
    if listexists 'f_leytry'
        removelist 'f_leytry'
        if insysmsg 'cannot perform that ability yet'
            // still on cooldown
        else
            settimer 'leyline' 0
        endif
    endif

    // ===== 2. Clear once, after everything has been read =====
    clearsysmsg

    // A Poison cursor that arrived late must never be used by a self-target spell
    if targetexists
        hotkey 'Cancel Current Target'
        wait 100
    endif
    // A Last Target pressed while no cursor was open is queued by Razor and
    // would grab our next cursor, sending the spell to the old target
    if queued
        hotkey 'Clear Target Queue'
    endif

    // ===== 3. Escape =====
    if listexists 'f_player'
        removelist 'f_player'
        overhead 'PLAYER CLOSE! ESCAPING!' 38
        hotkey 'Cancel Current Target'
        hotkey '> Interrupt'
        whisper '[recall Guild Hall'
        removelist 'nox_multi'
        if listexists 'f_leytry'
            removelist 'f_leytry'
        endif
        stop
    endif

    if listexists 'cfg_escape' and skill 'Tracking' >= 80 and not findbuff 'Tracking' and timer 'tracktry' >= 10000
        settimer 'tracktry' 0
        if gumpexists 4267467659
            gumpclose 4267467659
        endif
        useskill 'Tracking'
        waitforgump 4267467659 2000
        gumpresponse TrackButton 4267467659
        wait 500
        if gumpexists 4267467659
            gumpresponse 6 4267467659
        endif
        wait 500
    endif

    // ===== 4. Defensive =====
    @setvar! HealFailed 0
    if diffhits >= HealPotDiff and timer 'healpot' >= 10000 and findtype 3852 self
        dclicktype 3852
        settimer 'healpot' 0
        wait 200
    endif

    if poisoned and timer 'curepot' >= 2000
        if findtype 3847 self
            dclicktype 3847
            settimer 'curepot' 0
            wait 200
        elseif mana >= 6 and findtype 3972 self and findtype 3973 self
            // Wait for a running cast to finish and drop any stray cursor,
            // so 'target self' can only ever answer this heal/cure
            for 25
                if not casting
                    break
                endif
                wait 100
            endfor
            if targetexists
                hotkey 'Cancel Current Target'
                wait 100
            endif
            cast 'Cure'
            // Wait for the cursor, but stop at once if the cast was refused
            for 20
                if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                    break
                endif
                wait 100
            endfor
            if targetexists
                target 'self'
                settimer 'curepot' 0
            else
                // Refused (still recovering): no attack spells this pass,
                // the next pass tries the cure again first
                @setvar! HealFailed 1
            endif
        endif
    endif

    if diffhits >= GreaterHealDiff and mana >= 11 and timer 'gheal' >= 2500 and findtype 3972 self and findtype 3973 self and findtype 3974 self and findtype 3981 self
        // Wait for a running cast to finish and drop any stray cursor,
        // so 'target self' can only ever answer this heal/cure
        for 25
            if not casting
                break
            endif
            wait 100
        endfor
        if targetexists
            hotkey 'Cancel Current Target'
            wait 100
        endif
        cast 'Greater Heal'
        // Wait for the cursor, but stop at once if the cast was refused
        for 25
            if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                break
            endif
            wait 100
        endfor
        if targetexists
            target 'self'
            // Only start the timer when the heal really went off
            settimer 'gheal' 0
        else
            // Refused (still recovering): no attack spells this pass,
            // the next pass tries the heal again first
            @setvar! HealFailed 1
        endif
    endif

    if mana < 50 and timer 'mushroom' >= 60000
        if timer 'mushtry' >= 3000
            dclicktype 29012
            settimer 'mushtry' 0
            wait 200
        endif
    endif

    // Mind Rot (self buff)
    // Shares the 1 s gap with Poison Strike, so they don't block each other
    if UseMindRot = 1 and skill 'Necromancy' >= 75 and not findbuff 'Mind Rot' and timer 'mindrot' >= 30000 and timer 'necrogap' >= 1000
        say '[MindRot'
        wait 250
        if insysmsg 'seconds before you may use that ability again'
            settimer 'mindrot' 25000
        else
            settimer 'mindrot' 0
        endif
        settimer 'necrogap' 0
    endif

    // ===== 5. Scan the mobs in range =====
    @setvar! PoisonT 0
    @setvar! UpcastT 0
    @setvar! StrikeT 0
    @setvar! FirstMob 0
    for 6
        hotkey 'Next Grey Monster Target'
        wait 50
        if insysmsg 'No one matching'
            break
        endif
        @setvar! scanC lasttarget
        if find scanC ground -1 -1 ScanRange and not dead scanC and not find scanC ground -1 -1 0
            getlabel scanC scanLabel
            if "-" in scanLabel
                wait 100
                getlabel scanC scanLabel
            endif
            if "tame" in scanLabel or "summoned" in scanLabel
                // never touch own pets
            else
                if FirstMob = 0
                    @setvar! FirstMob scanC
                endif
                // Not poisoned at all: highest priority, done scanning
                if "Ticks" in scanLabel
                    // poisoned - handled below
                else
                    @setvar! PoisonT scanC
                    break
                endif
                // Poisoned but below Lethal: remember the first one for upcasting
                if UpcastT = 0
                    if "Lethal" in scanLabel
                        // already at the top
                    else
                        @setvar! UpcastT scanC
                    endif
                endif
                // Poisoned: candidate for Poison Strike?
                if StrikeT = 0 and StrikeTicks >= 2
                    if "[2" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                    if StrikeTicks >= 3 and "[3" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                    if StrikeTicks >= 4 and "[4" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                    if StrikeTicks >= 5 and "[5" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                    if StrikeTicks >= 6 and "[6" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                    if StrikeTicks >= 7 and "[7" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                    if StrikeTicks >= 8 and "[8" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                    if StrikeTicks >= 9 and "[9" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                endif
            endif
        endif
    endfor

    // ===== 6. Pets: keep them on one mob until it dies =====
    if PetsAttack = 1 and followers > 0 and FirstMob != 0
        @setvar! NeedPetTarget 0
        if petTarget = 0
            @setvar! NeedPetTarget 1
        elseif dead petTarget or not find petTarget ground -1 -1 ScanRange
            @setvar! NeedPetTarget 1
        endif
        if NeedPetTarget = 1
            @setvar! petTarget FirstMob
            attack petTarget
            say 'All kill'
            waitfortarget 1500
            if targetexists
                target petTarget
            endif
        endif
    endif

    // ===== 7. Leyline =====
    // Leyline on cooldown. Only while mobs are in range.
    // Not a spell, so it never blocks a cast.
    if FirstMob != 0 and UseLeyline = 1 and timer 'leyline' >= LeylineCD and timer 'leytry' >= 3000
        say '[WeaponAbility2'
        settimer 'leytry' 0
        if not listexists 'f_leytry'
            createlist 'f_leytry'
        endif
    endif

    // ===== 8. Act =====
    if HealFailed = 1
        // A heal or cure was refused: no attack spells this pass,
        // the next pass tries it again first
        wait 100
    elseif PoisonT != 0 and mana >= 9 and mana >= KeepMana and findtype 3976 self
        cast 'Poison'
        // Wait for the cursor, but stop at once if the cast was refused
        for 25
            if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                break
            endif
            wait 100
        endfor
        if targetexists
            if dead PoisonT or not find PoisonT ground -1 -1 12
                hotkey 'Cancel Current Target'
            else
                target PoisonT
            endif
        endif
    elseif StrikeT != 0 and skill 'Necromancy' >= 55 and timer 'pstrike' >= 30000 and timer 'necrogap' >= 1000
        say '[PoisonStrike'
        waitfortarget 1500
        if targetexists
            target StrikeT
        endif
        // Wait up to 1 s for the server's answer.
        // Only "unholy symbols remaining" counts as a real hit.
        @setvar! StrikeResult 0
        for 10
            if insysmsg 'nholy symbols remaining'
                @setvar! StrikeResult 1
                break
            endif
            if insysmsg 'seconds before you may use that ability again'
                @setvar! StrikeResult 2
                break
            endif
            if insysmsg 'do not have a Spell-based poison' or insysmsg 'another Necromancy ability'
                @setvar! StrikeResult 3
                break
            endif
            wait 100
        endfor
        if StrikeResult = 1
            settimer 'pstrike' 0
            overhead '[ POISON STRIKE ]' 77 StrikeT
        elseif StrikeResult = 2
            // Still on cooldown: try again in 5 s
            settimer 'pstrike' 25000
        else
            // Blocked, no poison or no answer: try again in 2 s
            settimer 'pstrike' 28000
        endif
        settimer 'necrogap' 0
    elseif UpcastLethal = 1 and UpcastT != 0 and mana >= 9 and mana >= KeepMana and findtype 3976 self
        cast 'Poison'
        // Wait for the cursor, but stop at once if the cast was refused
        for 25
            if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                break
            endif
            wait 100
        endfor
        if targetexists
            if dead UpcastT or not find UpcastT ground -1 -1 12
                hotkey 'Cancel Current Target'
            else
                target UpcastT
            endif
        endif
    elseif FirstMob = 0
        if timer 'idlemsg' >= 4000
            overhead 'Nothing in range' 53
            settimer 'idlemsg' 0
        endif
        wait 400
    elseif PoisonT != 0
        if timer 'idlemsg' >= 4000
            overhead 'Out of mana or Nightshade!' 33
            settimer 'idlemsg' 0
        endif
        wait 400
    elseif UpcastLethal = 1 and UpcastT != 0
        if timer 'idlemsg' >= 4000
            overhead 'Out of mana or Nightshade!' 33
            settimer 'idlemsg' 0
        endif
        wait 400
    else
        if timer 'idlemsg' >= 4000
            overhead 'All poisoned' 68
            settimer 'idlemsg' 0
        endif
        // Short pause so an expiring poison is noticed quickly
        wait 200
    endif

    wait 100
endwhile

if listexists 'nox_multi'
    removelist 'nox_multi'
endif
if listexists 'f_player'
    removelist 'f_player'
endif
if listexists 'f_leytry'
    removelist 'f_leytry'
endif
overhead 'Multi target stopped' 33
