// ==========================================================
// Nox Multi - poison everything in range
// Press the hotkey to start, again to stop.
//
// Every pass it cycles through the grey monsters nearby.
// Priority: 1. poison unpoisoned mobs
//           2. Poison Strike on a mob with few ticks left
//           3. upcast poisoned mobs to Lethal
// Pets are sent at one mob at a time.
// Note: the scan has to cycle your target highlight - that
// is the only way Razor can read a mob's poison state.
// It starts at the closest mob and skips anything farther
// than ScanRange.
// ==========================================================

// ===== CONFIG =====
// Escape on enemy players via Tracking.
// To DISABLE: put // in front of the createlist line below.
if listexists 'cfg_escape'
    removelist 'cfg_escape'
endif
//createlist 'cfg_escape'

// Tracking gump button: 7 = Players, 8 = hostile players only
@setvar! TrackButton 7

// Unpoisoned mobs always come first. Once every mob in range carries
// poison, upcast the weaker ones to Lethal (1 = on, 0 = off)
@setvar! UpcastLethal 1

// Only mobs within this many tiles are poisoned (max 12 for spells).
// If even the closest mob is farther, the scan stops at once.
@setvar! ScanRange 10

// Poison Strike on mobs with this many ticks or fewer left (2 - 5), 0 = off
@setvar! StrikeTicks 3

// Mind Rot (1 = on, 0 = off)
@setvar! UseMindRot 1

// Send summons at one mob at a time (1 = on, 0 = off)
@setvar! PetsAttack 1

// Heal thresholds (missing hit points)
@setvar! HealPotDiff 30
@setvar! GreaterHealDiff 30

// ===== Toggle =====
// The single target script can't be running at the same time
if listexists 'nox_single'
    removelist 'nox_single'
endif
if listexists 'nox_multi'
    removelist 'nox_multi'
    if targetexists
        hotkey 'Cancel Current Target'
    endif
    overhead 'Multi target OFF' 33
    stop
endif
createlist 'nox_multi'

if listexists 'f_player'
    removelist 'f_player'
endif
if targetexists
    hotkey 'Cancel Current Target'
    wait 100
endif
clearsysmsg

if listexists 'cfg_escape'
    overhead 'Poisoning everything ! (escape ON)' 68
endif
if not listexists 'cfg_escape'
    overhead 'Poisoning everything ! (escape OFF)' 68
endif

warmode on
@setvar! petTarget 0

// ===== Timers (99999 = ready immediately) =====
if not timerexists 'healpot'
    createtimer 'healpot'
    settimer 'healpot' 99999
endif
if not timerexists 'curepot'
    createtimer 'curepot'
    settimer 'curepot' 99999
endif
if not timerexists 'gheal'
    createtimer 'gheal'
    settimer 'gheal' 99999
endif
if not timerexists 'mushroom'
    createtimer 'mushroom'
    settimer 'mushroom' 99999
endif
if not timerexists 'mushtry'
    createtimer 'mushtry'
    settimer 'mushtry' 99999
endif
if not timerexists 'tracktry'
    createtimer 'tracktry'
    settimer 'tracktry' 99999
endif
if not timerexists 'pstrike'
    createtimer 'pstrike'
    settimer 'pstrike' 99999
endif
if not timerexists 'mindrot'
    createtimer 'mindrot'
    settimer 'mindrot' 99999
endif
if not timerexists 'idlemsg'
    createtimer 'idlemsg'
    settimer 'idlemsg' 99999
endif

while listexists 'nox_multi' and not dead

    // ===== 1. Read the journal into flags =====
    if listexists 'cfg_escape' and insysmsg ' spaces'
        if not listexists 'f_player'
            createlist 'f_player'
        endif
    endif
    if insysmsg 'consume a magic mushroom'
        settimer 'mushroom' 0
    endif

    // ===== 2. Clear once, after everything has been read =====
    clearsysmsg

    // A Poison cursor that arrived late must never be used by a self-target spell
    if targetexists
        hotkey 'Cancel Current Target'
        wait 100
    endif

    // ===== 3. Escape =====
    if listexists 'f_player'
        removelist 'f_player'
        overhead 'PLAYER CLOSE! ESCAPING!' 38
        hotkey 'Cancel Current Target'
        hotkey '> Interrupt'
        whisper '[recall Guild Hall'
        removelist 'nox_multi'
        stop
    endif

    if listexists 'cfg_escape' and skill 'Tracking' >= 80 and not findbuff 'Tracking' and timer 'tracktry' >= 10000
        settimer 'tracktry' 0
        if gumpexists 4267467659
            gumpclose 4267467659
        endif
        useskill 'Tracking'
        waitforgump 4267467659 2000
        gumpresponse TrackButton 4267467659
        wait 500
        if gumpexists 4267467659
            gumpresponse 6 4267467659
        endif
        wait 500
    endif

    // ===== 4. Defensive =====
    if diffhits >= HealPotDiff and timer 'healpot' >= 10000 and findtype 3852 self
        dclicktype 3852
        settimer 'healpot' 0
        wait 200
    endif

    if poisoned and timer 'curepot' >= 2000
        if findtype 3847 self
            dclicktype 3847
            settimer 'curepot' 0
            wait 200
        elseif mana >= 6 and findtype 3972 self and findtype 3973 self
            // Wait for a running cast to finish and drop any stray cursor,
            // so 'target self' can only ever answer this heal/cure
            for 25
                if not casting
                    break
                endif
                wait 100
            endfor
            if targetexists
                hotkey 'Cancel Current Target'
                wait 100
            endif
            cast 'Cure'
            // Wait for the cursor, but stop at once if the cast was refused
            for 20
                if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                    break
                endif
                wait 100
            endfor
            if targetexists
                target 'self'
            endif
            settimer 'curepot' 0
        endif
    endif

    if diffhits >= GreaterHealDiff and mana >= 11 and timer 'gheal' >= 2500 and findtype 3972 self and findtype 3973 self and findtype 3974 self and findtype 3981 self
        // Wait for a running cast to finish and drop any stray cursor,
        // so 'target self' can only ever answer this heal/cure
        for 25
            if not casting
                break
            endif
            wait 100
        endfor
        if targetexists
            hotkey 'Cancel Current Target'
            wait 100
        endif
        cast 'Greater Heal'
        // Wait for the cursor, but stop at once if the cast was refused
        for 25
            if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                break
            endif
            wait 100
        endfor
        if targetexists
            target 'self'
        endif
        settimer 'gheal' 0
    endif

    if mana < 50 and timer 'mushroom' >= 60000
        if timer 'mushtry' >= 3000
            dclicktype 29012
            settimer 'mushtry' 0
            wait 200
        endif
    endif

    // Mind Rot (self buff)
    if UseMindRot = 1 and skill 'Necromancy' >= 75 and not findbuff 'Mind Rot' and timer 'mindrot' >= 30000
        say '[MindRot'
        wait 250
        if insysmsg 'seconds before you may use that ability again'
            settimer 'mindrot' 25000
        else
            settimer 'mindrot' 0
        endif
    endif

    // ===== 5. Scan the mobs in range =====
    // Step 1 takes the closest grey monster. If even that one is farther
    // than ScanRange, nothing is in range and the scan stops right there.
    // Later steps cycle 'Next Grey Monster Target', which goes through
    // every mob on screen in no particular order, near or far. Far mobs
    // are skipped, and the scan stops once the cycle comes back round.
    @setvar! PoisonT 0
    @setvar! UpcastT 0
    @setvar! StrikeT 0
    @setvar! FirstMob 0
    @setvar! scanStep 0
    @setvar! FirstNext 0
    for 10
        if scanStep = 0
            hotkey 'Target Closest Grey Monster'
        else
            hotkey 'Next Grey Monster Target'
        endif
        wait 50
        if insysmsg 'No one matching'
            break
        endif
        @setvar! scanC lasttarget
        if scanStep = 0
            @setvar! scanStep 1
            if not find scanC ground -1 -1 ScanRange
                // the closest mob is already too far
                break
            endif
        elseif scanStep = 1
            @setvar! scanStep 2
            @setvar! FirstNext scanC
        elseif scanC = FirstNext
            // back at the start of the cycle: every mob has been seen
            break
        endif
        if find scanC ground -1 -1 ScanRange and not dead scanC and not find scanC ground -1 -1 0
            getlabel scanC scanLabel
            if "-" in scanLabel
                wait 100
                getlabel scanC scanLabel
            endif
            if "tame" in scanLabel or "summoned" in scanLabel
                // never touch own pets
            else
                if FirstMob = 0
                    @setvar! FirstMob scanC
                endif
                // Not poisoned at all: highest priority, done scanning
                if "Ticks" in scanLabel
                    // poisoned - handled below
                else
                    @setvar! PoisonT scanC
                    break
                endif
                // Poisoned but below Lethal: remember the first one for upcasting
                if UpcastT = 0
                    if "Lethal" in scanLabel
                        // already at the top
                    else
                        @setvar! UpcastT scanC
                    endif
                endif
                // Poisoned: candidate for Poison Strike?
                if StrikeT = 0 and StrikeTicks >= 2
                    if "[2" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                    if StrikeTicks >= 3 and "[3" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                    if StrikeTicks >= 4 and "[4" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                    if StrikeTicks >= 5 and "[5" in scanLabel
                        @setvar! StrikeT scanC
                    endif
                endif
            endif
        endif
    endfor

    // ===== 6. Pets: keep them on one mob until it dies =====
    if PetsAttack = 1 and followers > 0 and FirstMob != 0
        @setvar! NeedPetTarget 0
        if petTarget = 0
            @setvar! NeedPetTarget 1
        elseif dead petTarget or not find petTarget ground -1 -1 ScanRange
            @setvar! NeedPetTarget 1
        endif
        if NeedPetTarget = 1
            @setvar! petTarget FirstMob
            attack petTarget
            say 'All kill'
            waitfortarget 1500
            if targetexists
                target petTarget
            endif
        endif
    endif

    // ===== 7. Act =====
    if PoisonT != 0 and mana >= 9 and findtype 3976 self
        cast 'Poison'
        // Wait for the cursor, but stop at once if the cast was refused
        for 25
            if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                break
            endif
            wait 100
        endfor
        if targetexists
            if dead PoisonT or not find PoisonT ground -1 -1 12
                hotkey 'Cancel Current Target'
            else
                target PoisonT
            endif
        endif
    elseif StrikeT != 0 and skill 'Necromancy' >= 55 and timer 'pstrike' >= 30000
        say '[PoisonStrike'
        waitfortarget 1500
        if targetexists
            target StrikeT
        endif
        wait 250
        if insysmsg 'seconds before you may use that ability again' or insysmsg 'do not have a Spell-based poison'
            settimer 'pstrike' 25000
        else
            settimer 'pstrike' 0
            overhead '[ POISON STRIKE ]' 77 StrikeT
        endif
    elseif UpcastLethal = 1 and UpcastT != 0 and mana >= 9 and findtype 3976 self
        cast 'Poison'
        // Wait for the cursor, but stop at once if the cast was refused
        for 25
            if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                break
            endif
            wait 100
        endfor
        if targetexists
            if dead UpcastT or not find UpcastT ground -1 -1 12
                hotkey 'Cancel Current Target'
            else
                target UpcastT
            endif
        endif
    elseif FirstMob = 0
        if timer 'idlemsg' >= 4000
            overhead 'Nothing in range' 53
            settimer 'idlemsg' 0
        endif
        wait 400
    elseif PoisonT != 0
        if timer 'idlemsg' >= 4000
            overhead 'Out of mana or Nightshade!' 33
            settimer 'idlemsg' 0
        endif
        wait 400
    elseif UpcastLethal = 1 and UpcastT != 0
        if timer 'idlemsg' >= 4000
            overhead 'Out of mana or Nightshade!' 33
            settimer 'idlemsg' 0
        endif
        wait 400
    else
        if timer 'idlemsg' >= 4000
            overhead 'All poisoned' 68
            settimer 'idlemsg' 0
        endif
        // Short pause so an expiring poison is noticed quickly
        wait 200
    endif

    wait 100
endwhile

if listexists 'nox_multi'
    removelist 'nox_multi'
endif
if listexists 'f_player'
    removelist 'f_player'
endif
overhead 'Multi target stopped' 33
