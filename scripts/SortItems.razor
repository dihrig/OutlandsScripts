// --- next bag ---
// pushlist 'routes' 'bag'
// pushlist 'routes' 0x........
// pushlist 'routes' 0x....
// ----------------------------------------------------------

// open everything so the server sends the contents
dclick lootbag
wait 650
foreach cont in 'opencont'
    dclick cont
    wait 650
endfor

// flag list: non-empty = the next entry is a bag serial
@removelist 'nextisbag'
createlist 'nextisbag'

// sort
foreach entry in 'routes'
    if entry = 'bag'
        pushlist 'nextisbag' 1
    elseif list 'nextisbag' > 0
        // bag serial -> new destination
        @setvar! 'dest' entry
        clearlist 'nextisbag'
    else
        // item ID -> move all of that type into current destination
        while findtype entry lootbag as item
            lift item 60000
            wait 600
            drop dest -1 -1 0
            wait 600
        endwhile
    endif
endfor

overhead 'Loot sorted!' 68