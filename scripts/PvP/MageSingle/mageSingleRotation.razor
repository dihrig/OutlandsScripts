// ==========================================================
// mageSingleRotation - Arcane staff mage, single target
// Start/stop and heal/cure logic are the same as in Nox Single,
// but the enemy is picked with a plain target cursor (no Poison).
// Only the offensive part is new: a priority list.
// Press the hotkey: a target cursor appears, click your enemy.
// If your last target is still alive and in range, the script
// continues on it instead (no cursor). Press again to stop.
//
// Every pass: heals/cures/potions first. Then the first
// action whose conditions are met (one action per pass):
//   1. Mushroom below MushroomMana (does not count as the action)
//   2. Greater Explosion potion every 11.25 s (potion codex)
//   3. Curse every 58 s, and at once on a new target
//   4. Lightning every 15 s (Grimoire proc)
//   5. Harm every 15 s (Grimoire proc)
//   6. Fireball every 15 s (Grimoire proc)
//   7. Magic Arrow every 15 s (Grimoire proc)
//   8. Filler spell when nothing else is due: Flamestrike (default),
//      Harm or Mind Blast (a Harm filler does not reset the Harm proc timer)
// Before the action: Leyline on cooldown at LeylineMana or less
// (not a spell, does not count as the action either)
// If the target vanishes (dead, hidden or invisible), the script keeps
// healing and waits LostGrace ms for it to come back before it looks
// for a new one.
// Every step except the mushroom can be switched off in the CONFIG.
// Soulfire, Catalyst and Mana Drain stay manual.
// ==========================================================

// ===== CONFIG =====
// 1. Eat the magic mushroom below this mana (60 s cooldown)
@setvar! MushroomMana 75
// Leyline (Arcane weapon ability 2) on cooldown at this much mana or
// less (1 = on, 0 = off)
@setvar! UseLeyline 1
@setvar! LeylineMana 80
// Wait this long after Leyline went off before trying again (ms).
// 60000 comes from community scripts - CHECK IN-GAME: if your Leyline
// cooldown bar is shorter, lower this. A try counts as gone off only
// when the Leyline buff shows up, any other try is retried 3 s later.
@setvar! LeylineCD 60000
// 2. Greater Explosion potion every ExploEvery ms (1 = on, 0 = off).
// Set to 0 in groups if you're not sure they spare your friends.
// 11250 = 15 s base cooldown - 3.75 s from the potion codex
@setvar! UseExplo 1
@setvar! ExploEvery 11250
// 3. Curse every CurseEvery ms (1 = on, 0 = off)
@setvar! UseCurse 1
@setvar! CurseEvery 58000
// 4./5./6. Lightning, Harm and Fireball Grimoire procs every ProcEvery ms
// (1 = on, 0 = off)
@setvar! UseLightning 1
@setvar! UseHarm 1
@setvar! UseFireball 1
@setvar! ProcEvery 15000
// 7. Magic Arrow every MagicArrowEvery ms (1 = on, 0 = off), 4 mana
@setvar! UseMagicArrow 1
@setvar! MagicArrowEvery 15000
// 8. Filler spell, cast when nothing above is due:
//    1 = Flamestrike (default), 2 = Harm, 3 = Mind Blast, 0 = no filler
@setvar! FillerSpell 1
// Flamestrike filler: at FSMana or more, or at FSSoulfireMana while the
// Soulfire buff is active (Flamestrike costs 40)
@setvar! FSMana 51
@setvar! FSSoulfireMana 40
// Harm filler: at HarmFillerMana or more. 17 = Harm (6) + a Greater Heal
// (11) kept in reserve. Set to 6 to burn mana down to zero.
// Does not reset the Harm proc timer.
@setvar! HarmFillerMana 17
// Mind Blast filler: at MBFillerMana or more. 25 = Mind Blast (14) +
// a Greater Heal (11) kept in reserve. Set to 14 to burn mana to zero.
@setvar! MBFillerMana 25

// Heal thresholds (missing hit points)
@setvar! HealPotDiff 30
@setvar! GreaterHealDiff 30

// When the target dies: 1 = take the closest grey monster, 0 = stop
@setvar! AutoNext 1
// When the target vanishes, wait this long for it to come back (ms)
// before taking a new one (or stopping with AutoNext 0). Covers mobs
// that go hidden/invisible for a few seconds. The client can't tell a
// kill from a vanish, so this is also the pause after each kill before
// the next target is picked. 0 = old behaviour (switch at once).
@setvar! LostGrace 3000
// Stop when no valid target could be found for this long (ms),
// e.g. the closest monster is out of range or is a pet.
// Keep it larger than LostGrace.
@setvar! NoTargetStop 10000

// On start, continue on your last target if it is still alive and in
// range (1 = on, 0 = always ask with a target cursor)
@setvar! ResumeLastTarget 1

// ===== Toggle =====
// The multi target script can't be running at the same time
if listexists 'nox_multi'
    removelist 'nox_multi'
endif
if listexists 'nox_single'
    removelist 'nox_single'
    if targetexists
        hotkey 'Cancel Current Target'
    endif
    overhead 'Single target OFF' 33
    stop
endif
createlist 'nox_single'

// A Leyline try flag left over from a previous run would be read as
// "Leyline went off" on the first pass (the journal is cleared by then)
if listexists 'f_leytry'
    removelist 'f_leytry'
endif

// Drop a cursor left over from a previous run
if targetexists
    hotkey 'Cancel Current Target'
    wait 100
endif

// Remembers which enemy was cursed last (Curse is due at once on a new
// one). Kept between runs, so a restart on the same enemy doesn't curse
// it again before CurseEvery is up.
if not listexists 'rcursed'
    createlist 'rcursed'
endif

// ===== Timers (99999 = ready immediately) =====
if not timerexists 'healpot'
    createtimer 'healpot'
    settimer 'healpot' 99999
endif
if not timerexists 'curepot'
    createtimer 'curepot'
    settimer 'curepot' 99999
endif
if not timerexists 'gheal'
    createtimer 'gheal'
    settimer 'gheal' 99999
endif
if not timerexists 'attackref'
    createtimer 'attackref'
    settimer 'attackref' 99999
endif
// Time since the script last had a valid target
if not timerexists 'rnotarget'
    createtimer 'rnotarget'
endif
// Time since the current enemy was last seen (grace for hidden mobs)
if not timerexists 'rlost'
    createtimer 'rlost'
endif
// Throttles the search for a new target to once per second
if not timerexists 'rsearch'
    createtimer 'rsearch'
    settimer 'rsearch' 99999
endif
// Rotation timers, each reset when its action starts
if not timerexists 'leyline'
    createtimer 'leyline'
    settimer 'leyline' 99999
endif
if not timerexists 'leytry'
    createtimer 'leytry'
    settimer 'leytry' 99999
endif
if not timerexists 'rmushroom'
    createtimer 'rmushroom'
    settimer 'rmushroom' 99999
endif
if not timerexists 'rexplo'
    createtimer 'rexplo'
    settimer 'rexplo' 99999
endif
// Kept between runs too (see 'rcursed' above)
if not timerexists 'rcurse'
    createtimer 'rcurse'
    settimer 'rcurse' 999999
endif
if not timerexists 'rlightning'
    createtimer 'rlightning'
    settimer 'rlightning' 99999
endif
if not timerexists 'rharm'
    createtimer 'rharm'
    settimer 'rharm' 99999
endif
if not timerexists 'rfireball'
    createtimer 'rfireball'
    settimer 'rfireball' 99999
endif
if not timerexists 'rmagicarrow'
    createtimer 'rmagicarrow'
    settimer 'rmagicarrow' 99999
endif

// ==========================================================
// PHASE 1: pick the target (last target, or a target cursor)
// ==========================================================
@setvar! NoxResume 0

// The enemy lives in its own variable, so other target hotkeys can't move it.
// Last target still alive and in range? Then continue on it.
if ResumeLastTarget = 1
    @setvar! noxCand lasttarget
    if find noxCand ground -1 -1 12
        if dead noxCand or find noxCand ground -1 -1 0
            // dead, or that's us
        else
            getlabel noxCand candLabel
            if "tame" in candLabel or "summoned" in candLabel
                // own pet - ask for a new enemy
            else
                @setvar! noxMain noxCand
                @setvar! NoxResume 1
            endif
        endif
    endif
endif

if NoxResume = 1
    if queued
        hotkey 'Clear Target Queue'
    endif
    clearsysmsg
    overhead '[ CONTINUE ]' 68 noxMain
else
    // A Last Target pressed while no cursor was open is queued by Razor and
    // would grab our next cursor, picking the old target
    if queued
        hotkey 'Clear Target Queue'
    endif
    overhead 'Select enemy' 68
    clearsysmsg
    // No value = Razor opens a plain target cursor and waits for your click
    // (no spell, so nothing is cast on the enemy)
    setvar noxMain

    if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
        overhead 'No valid target' 33
        removelist 'nox_single'
        stop
    endif
endif

warmode on
attack noxMain
settimer 'attackref' 0
if followers > 0
    say 'All kill'
    waitfortarget 1500
    if targetexists
        target noxMain
    endif
endif

// ==========================================================
// PHASE 2: rotation
// ==========================================================
overhead 'Rotating !' 68
clearsysmsg
settimer 'rnotarget' 0
settimer 'rlost' 0

while listexists 'nox_single' and not dead

    // ===== 1. Clear the journal =====
    // Did the last Leyline try go off? Only the Leyline buff counts as
    // success. Anything else (refused, no answer) is retried 3 s later.
    if listexists 'f_leytry'
        removelist 'f_leytry'
        if findbuff 'Leyline'
            settimer 'leyline' 0
        endif
    endif
    clearsysmsg

    // A stray cursor must never be used by a self-target spell
    if targetexists
        hotkey 'Cancel Current Target'
        wait 100
    endif
    // A Last Target pressed while no cursor was open is queued by Razor and
    // would grab our next cursor, sending the spell to the old target
    if queued
        hotkey 'Clear Target Queue'
    endif

    // ===== 2. Defensive =====
    @setvar! HealFailed 0
    if diffhits >= HealPotDiff and timer 'healpot' >= 10000 and findtype 3852 self
        dclicktype 3852
        settimer 'healpot' 0
        wait 200
    endif

    if poisoned and timer 'curepot' >= 2000
        if findtype 3847 self
            dclicktype 3847
            settimer 'curepot' 0
            wait 200
        elseif mana >= 6
            // Wait for a running cast to finish and drop any stray cursor,
            // so 'target self' can only ever answer this heal/cure
            for 25
                if not casting
                    break
                endif
                wait 100
            endfor
            if targetexists
                hotkey 'Cancel Current Target'
                wait 100
            endif
            cast 'Cure'
            // Wait for the cursor, but stop at once if the cast was refused
            for 20
                if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                    break
                endif
                wait 100
            endfor
            if targetexists
                target 'self'
                settimer 'curepot' 0
            else
                // Refused (still recovering): no attack spells this pass,
                // the next pass tries the cure again first
                @setvar! HealFailed 1
            endif
        endif
    endif

    if diffhits >= GreaterHealDiff and mana >= 11 and timer 'gheal' >= 2500
        // Wait for a running cast to finish and drop any stray cursor,
        // so 'target self' can only ever answer this heal/cure
        for 25
            if not casting
                break
            endif
            wait 100
        endfor
        if targetexists
            hotkey 'Cancel Current Target'
            wait 100
        endif
        cast 'Greater Heal'
        // Wait for the cursor, but stop at once if the cast was refused
        for 25
            if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                break
            endif
            wait 100
        endfor
        if targetexists
            target 'self'
            // Only start the timer when the heal really went off
            settimer 'gheal' 0
        else
            // Refused (still recovering): no attack spells this pass,
            // the next pass tries the heal again first
            @setvar! HealFailed 1
        endif
    endif

    // ===== 3. Target still alive? =====
    // A hidden/invisible mob is removed from your client, so it looks
    // exactly like a dead one. Every pass checks noxMain again first, so
    // if it reappears within the grace time the rotation just carries on.
    @setvar! HaveTarget 1
    if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
        @setvar! HaveTarget 0
    endif

    if HaveTarget = 1
        settimer 'rlost' 0
    elseif timer 'rlost' < LostGrace
        // Just vanished: keep healing, wait for it to come back
    elseif AutoNext = 0
        overhead 'Target gone - stopped' 53
        removelist 'nox_single'
        stop
    elseif timer 'rsearch' >= 1000
        settimer 'rsearch' 0
        hotkey 'Target Closest Grey Monster'
        wait 150
        if insysmsg 'No one matching'
            // Nothing nearby (yet): keep looking, NoTargetStop ends the
            // script if nothing turns up. noxMain is still checked every
            // pass, so a mob that reappears late is taken up again.
        else
            @setvar! noxCand lasttarget
            getlabel noxCand candLabel
            if find noxCand ground -1 -1 0
                // that's us - never a target
            elseif "tame" in candLabel or "summoned" in candLabel
                @ignore noxCand
            elseif not find noxCand ground -1 -1 12
                // Closest monster is on screen but out of range: don't take it,
                // or it would be dropped again next pass and picked again
                // (Curse, 'All kill' and the overhead every pass)
            else
                @setvar! noxMain noxCand
                @setvar! HaveTarget 1
                settimer 'rlost' 0
                // New enemy: Curse is due at once, proc timers keep running
                settimer 'rcurse' 999999
                attack noxMain
                settimer 'attackref' 0
                if followers > 0
                    say 'All kill'
                    waitfortarget 1500
                    if targetexists
                        target noxMain
                    endif
                endif
                overhead '[ NEW TARGET ]' 68 noxMain
            endif
        endif
    endif

    // No usable target for too long (out of range, pets only...): stop
    // instead of looping on the target hotkey forever
    if HaveTarget = 1
        settimer 'rnotarget' 0
    elseif timer 'rnotarget' >= NoTargetStop
        overhead 'No target in range - stopped' 53
        removelist 'nox_single'
        stop
    endif

    // ===== 4. Rotation =====
    if HaveTarget = 1
        if timer 'attackref' >= 3000
            attack noxMain
            settimer 'attackref' 0
        endif

        // 1. Mushroom: not the action for this pass, the list goes on
        if mana < MushroomMana and timer 'rmushroom' >= 60000 and findtype 29012 self
            dclicktype 29012
            settimer 'rmushroom' 0
            wait 200
        endif

        // Leyline on cooldown at LeylineMana or less, never while its buff
        // is still up. Runs before the action, so it fires on the first
        // pass below LeylineMana. Not a spell, so it never blocks a cast.
        // The next pass checks the buff to see whether it went off.
        if UseLeyline = 1 and mana <= LeylineMana and not findbuff 'Leyline' and timer 'leyline' >= LeylineCD and timer 'leytry' >= 3000
            say '[WeaponAbility2'
            settimer 'leytry' 0
            if not listexists 'f_leytry'
                createlist 'f_leytry'
            endif
            // Give the buff time to show up
            wait 300
            attack noxMain
        endif

        // Is Curse due? Every CurseEvery, or at once on a new target
        @setvar! CurseDue 0
        if timer 'rcurse' >= CurseEvery
            @setvar! CurseDue 1
        elseif not inlist 'rcursed' noxMain
            @setvar! CurseDue 1
        endif
        // Is the chosen filler castable? Flamestrike needs less mana
        // while Soulfire is up
        @setvar! FillerOk 0
        if FillerSpell = 1
            if mana >= FSMana
                @setvar! FillerOk 1
            elseif findbuff 'Soulfire' and mana >= FSSoulfireMana
                @setvar! FillerOk 1
            endif
        elseif FillerSpell = 2
            if mana >= HarmFillerMana
                @setvar! FillerOk 1
            endif
        elseif FillerSpell = 3
            if mana >= MBFillerMana
                @setvar! FillerOk 1
            endif
        endif

        // A refused heal or cure means no action this pass
        if HealFailed = 0
            // Never start a rotation action while a cast or a cursor (also
            // the explosion potion's) is still active: wait for the cast
            // to finish, then drop a stray cursor and any queued target
            for 25
                if not casting
                    break
                endif
                wait 100
            endfor
            if targetexists
                hotkey 'Cancel Current Target'
                wait 100
            endif
            if queued
                hotkey 'Clear Target Queue'
            endif

            // 2. Greater Explosion potion on the target
            if UseExplo = 1 and timer 'rexplo' >= ExploEvery and findtype 3853 self
                dclicktype 3853
                settimer 'rexplo' 0
                waitfortarget 2000
                if targetexists
                    target noxMain
                endif
                wait 200
                // The potion's cursor must be closed before anything else
                if targetexists
                    hotkey 'Cancel Current Target'
                    wait 100
                endif

            // 3. Curse: due every CurseEvery, or at once on a new target.
            // 11 mana
            elseif UseCurse = 1 and CurseDue = 1 and mana >= 11
                clearsysmsg
                cast 'Curse'
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    // Reset now, so a failed targeting can't repeat this spell
                    settimer 'rcurse' 0
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                        // Only a really answered cursor counts as cursed
                        clearlist 'rcursed'
                        pushlist 'rcursed' noxMain
                    endif
                endif

            // 4. Lightning proc, 11 mana
            elseif UseLightning = 1 and timer 'rlightning' >= ProcEvery and mana >= 11
                clearsysmsg
                cast 'Lightning'
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    // Reset now, so a failed targeting can't repeat this spell
                    settimer 'rlightning' 0
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                    endif
                endif

            // 5. Harm proc, 6 mana
            elseif UseHarm = 1 and timer 'rharm' >= ProcEvery and mana >= 6
                clearsysmsg
                cast 'Harm'
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    // Reset now, so a failed targeting can't repeat this spell
                    settimer 'rharm' 0
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                    endif
                endif

            // 6. Fireball proc, 9 mana
            elseif UseFireball = 1 and timer 'rfireball' >= ProcEvery and mana >= 9
                clearsysmsg
                cast 'Fireball'
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    // Reset now, so a failed targeting can't repeat this spell
                    settimer 'rfireball' 0
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                    endif
                endif

            // 7. Magic Arrow, 4 mana
            elseif UseMagicArrow = 1 and timer 'rmagicarrow' >= MagicArrowEvery and mana >= 4
                clearsysmsg
                cast 'Magic Arrow'
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    // Reset now, so a failed targeting can't repeat this spell
                    settimer 'rmagicarrow' 0
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                    endif
                endif

            // 8. Filler: Flamestrike, Harm or Mind Blast (see FillerSpell).
            // No timer is reset, so a Harm filler doesn't touch the Harm proc
            elseif FillerOk = 1
                clearsysmsg
                if FillerSpell = 1
                    cast 'Flamestrike'
                elseif FillerSpell = 2
                    cast 'Harm'
                else
                    cast 'Mind Blast'
                endif
                // A refusal comes at once, without one the cast has started
                wait 300
                if not insysmsg 'recovered' and not insysmsg 'already casting'
                    waitfortarget 3500
                    if targetexists
                        target noxMain
                    endif
                endif
            endif
        endif
    endif

    wait 100
endwhile

if listexists 'nox_single'
    removelist 'nox_single'
endif
overhead 'Single target stopped' 33
