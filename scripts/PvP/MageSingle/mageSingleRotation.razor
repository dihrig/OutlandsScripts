// ==========================================================
// mageSingleRotation - Arcane staff mage, single target
// Start/stop, targeting, escape and heal/cure logic are the same as in
// Nox Single. Only the offensive part is new: a priority list.
// Press the hotkey: a Poison cursor appears, click your enemy.
// If your last target is still alive and in range, the script
// continues on it instead (no cursor). Press again to stop.
//
// Every pass: escape > heals/cures/potions first. Then the first
// action whose conditions are met (one action per pass):
//   1. Mushroom below MushroomMana (does not count as the action)
//   2. Greater Explosion potion every 15 s
//   3. Curse every 58 s, and at once on a new target
//   4. Harm every 15 s (Grimoire proc)
//   5. Fireball every 15 s (Grimoire proc)
//   6. Flamestrike at FSMana+ mana, or FSSoulfireMana+ with Soulfire up
//   7. Harm as cheap filler (does not reset the Harm proc timer)
// Soulfire, Leyline, Catalyst and Mana Drain stay manual.
// ==========================================================

// ===== CONFIG =====
// Escape on enemy players via Tracking.
// To DISABLE: put // in front of the createlist line below.
if listexists 'cfg_escape'
    removelist 'cfg_escape'
endif
//createlist 'cfg_escape'

// Tracking gump button: 7 = Players, 8 = hostile players only
@setvar! TrackButton 7

// 1. Eat the magic mushroom below this mana (60 s cooldown)
@setvar! MushroomMana 75
// 2. Greater Explosion potion every ExploEvery ms (1 = on, 0 = off).
// Set to 0 in groups if you're not sure they spare your friends.
@setvar! UseExplo 1
@setvar! ExploEvery 15000
// 3. Curse every CurseEvery ms
@setvar! CurseEvery 58000
// 4./5. Harm and Fireball Grimoire procs every ProcEvery ms
@setvar! ProcEvery 15000
// 6. Flamestrike at this much mana, or at FSSoulfireMana while the
// Soulfire buff is active
@setvar! FSMana 60
@setvar! FSSoulfireMana 40

// Heal thresholds (missing hit points)
@setvar! HealPotDiff 30
@setvar! GreaterHealDiff 30

// When the target dies: 1 = take the closest grey monster, 0 = stop
@setvar! AutoNext 1

// On start, continue on your last target if it is still alive and in
// range (1 = on, 0 = always ask with a Poison cursor)
@setvar! ResumeLastTarget 1

// ===== Toggle =====
// The multi target script can't be running at the same time
if listexists 'nox_multi'
    removelist 'nox_multi'
endif
if listexists 'nox_single'
    removelist 'nox_single'
    if targetexists
        hotkey 'Cancel Current Target'
    endif
    overhead 'Single target OFF' 33
    stop
endif
createlist 'nox_single'

// Reset state flags from any previous run
if listexists 'f_player'
    removelist 'f_player'
endif
if targetexists
    hotkey 'Cancel Current Target'
    wait 100
endif

// Remembers which enemy was cursed (Curse is due at once on a new one)
if listexists 'rcursed'
    removelist 'rcursed'
endif
createlist 'rcursed'

// ===== Timers (99999 = ready immediately) =====
if not timerexists 'healpot'
    createtimer 'healpot'
    settimer 'healpot' 99999
endif
if not timerexists 'curepot'
    createtimer 'curepot'
    settimer 'curepot' 99999
endif
if not timerexists 'gheal'
    createtimer 'gheal'
    settimer 'gheal' 99999
endif
if not timerexists 'tracktry'
    createtimer 'tracktry'
    settimer 'tracktry' 99999
endif
if not timerexists 'attackref'
    createtimer 'attackref'
    settimer 'attackref' 99999
endif
// Rotation timers, each reset when its action starts
if not timerexists 'rmushroom'
    createtimer 'rmushroom'
    settimer 'rmushroom' 99999
endif
if not timerexists 'rexplo'
    createtimer 'rexplo'
    settimer 'rexplo' 99999
endif
if not timerexists 'rcurse'
    createtimer 'rcurse'
endif
settimer 'rcurse' 999999
if not timerexists 'rharm'
    createtimer 'rharm'
    settimer 'rharm' 99999
endif
if not timerexists 'rfireball'
    createtimer 'rfireball'
    settimer 'rfireball' 99999
endif

// ==========================================================
// PHASE 1: pick the target (last target, or the first Poison cast)
// ==========================================================
@setvar! NoxResume 0

// The enemy lives in its own variable, so other target hotkeys can't move it.
// Last target still alive and in range? Then continue on it.
if ResumeLastTarget = 1
    @setvar! noxCand lasttarget
    if find noxCand ground -1 -1 12
        if dead noxCand or find noxCand ground -1 -1 0
            // dead, or that's us
        else
            getlabel noxCand candLabel
            if "tame" in candLabel or "summoned" in candLabel
                // own pet - ask for a new enemy
            else
                @setvar! noxMain noxCand
                @setvar! NoxResume 1
            endif
        endif
    endif
endif

if NoxResume = 1
    if queued
        hotkey 'Clear Target Queue'
    endif
    clearsysmsg
    overhead '[ CONTINUE ]' 68 noxMain
else
    if not findtype 3976 self
        overhead 'No Nightshade!' 33
        removelist 'nox_single'
        stop
    endif
    if mana < 9
        overhead 'Not enough mana!' 33
        removelist 'nox_single'
        stop
    endif

    // A Last Target pressed while no cursor was open is queued by Razor and
    // would grab our next cursor, sending the spell to the old target
    if queued
        hotkey 'Clear Target Queue'
    endif
    overhead 'Select enemy' 68
    clearsysmsg
    cast 'Poison'
    waitfortarget 3000
    if not targetexists
        overhead 'Cast did not start - try again' 33
        removelist 'nox_single'
        stop
    endif
    while targetexists
        wait 50
    endwhile

    @setvar! noxMain lasttarget

    if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
        overhead 'No valid target' 33
        removelist 'nox_single'
        stop
    endif
endif

warmode on
attack noxMain
settimer 'attackref' 0
if followers > 0
    say 'All kill'
    waitfortarget 1500
    if targetexists
        target noxMain
    endif
endif

// ==========================================================
// PHASE 2: rotation
// ==========================================================
if listexists 'cfg_escape'
    overhead 'Rotating ! (escape ON)' 68
endif
if not listexists 'cfg_escape'
    overhead 'Rotating ! (escape OFF)' 68
endif
clearsysmsg

while listexists 'nox_single' and not dead

    // ===== 1. Read the journal into flags =====
    if listexists 'cfg_escape' and insysmsg ' spaces'
        if not listexists 'f_player'
            createlist 'f_player'
        endif
    endif

    // ===== 2. Clear once, after everything has been read =====
    clearsysmsg

    // A Poison cursor that arrived late must never be used by a self-target spell
    if targetexists
        hotkey 'Cancel Current Target'
        wait 100
    endif
    // A Last Target pressed while no cursor was open is queued by Razor and
    // would grab our next cursor, sending the spell to the old target
    if queued
        hotkey 'Clear Target Queue'
    endif

    // ===== 3. Escape =====
    if listexists 'f_player'
        removelist 'f_player'
        overhead 'PLAYER CLOSE! ESCAPING!' 38
        hotkey 'Cancel Current Target'
        hotkey '> Interrupt'
        whisper '[recall Guild Hall'
        removelist 'nox_single'
        stop
    endif

    if listexists 'cfg_escape' and skill 'Tracking' >= 80 and not findbuff 'Tracking' and timer 'tracktry' >= 10000
        settimer 'tracktry' 0
        if gumpexists 4267467659
            gumpclose 4267467659
        endif
        useskill 'Tracking'
        waitforgump 4267467659 2000
        gumpresponse TrackButton 4267467659
        wait 500
        if gumpexists 4267467659
            gumpresponse 6 4267467659
        endif
        wait 500
    endif

    // ===== 4. Defensive =====
    @setvar! HealFailed 0
    if diffhits >= HealPotDiff and timer 'healpot' >= 10000 and findtype 3852 self
        dclicktype 3852
        settimer 'healpot' 0
        wait 200
    endif

    if poisoned and timer 'curepot' >= 2000
        if findtype 3847 self
            dclicktype 3847
            settimer 'curepot' 0
            wait 200
        elseif mana >= 6 and findtype 3972 self and findtype 3973 self
            // Wait for a running cast to finish and drop any stray cursor,
            // so 'target self' can only ever answer this heal/cure
            for 25
                if not casting
                    break
                endif
                wait 100
            endfor
            if targetexists
                hotkey 'Cancel Current Target'
                wait 100
            endif
            cast 'Cure'
            // Wait for the cursor, but stop at once if the cast was refused
            for 20
                if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                    break
                endif
                wait 100
            endfor
            if targetexists
                target 'self'
                settimer 'curepot' 0
            else
                // Refused (still recovering): no attack spells this pass,
                // the next pass tries the cure again first
                @setvar! HealFailed 1
            endif
        endif
    endif

    if diffhits >= GreaterHealDiff and mana >= 11 and timer 'gheal' >= 2500 and findtype 3972 self and findtype 3973 self and findtype 3974 self and findtype 3981 self
        // Wait for a running cast to finish and drop any stray cursor,
        // so 'target self' can only ever answer this heal/cure
        for 25
            if not casting
                break
            endif
            wait 100
        endfor
        if targetexists
            hotkey 'Cancel Current Target'
            wait 100
        endif
        cast 'Greater Heal'
        // Wait for the cursor, but stop at once if the cast was refused
        for 25
            if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                break
            endif
            wait 100
        endfor
        if targetexists
            target 'self'
            // Only start the timer when the heal really went off
            settimer 'gheal' 0
        else
            // Refused (still recovering): no attack spells this pass,
            // the next pass tries the heal again first
            @setvar! HealFailed 1
        endif
    endif

    // ===== 5. Target still alive? =====
    @setvar! HaveTarget 1
    if dead noxMain or not find noxMain ground -1 -1 12 or find noxMain ground -1 -1 0
        @setvar! HaveTarget 0
        if AutoNext = 0
            overhead 'Target gone - stopped' 53
            removelist 'nox_single'
            stop
        endif
        hotkey 'Target Closest Grey Monster'
        wait 150
        if insysmsg 'No one matching'
            overhead 'Target gone - nothing nearby' 53
            removelist 'nox_single'
            stop
        endif
        @setvar! noxCand lasttarget
        getlabel noxCand candLabel
        if find noxCand ground -1 -1 0
            // that's us - never a target
        elseif "tame" in candLabel or "summoned" in candLabel
            @ignore noxCand
        else
            @setvar! noxMain noxCand
            @setvar! HaveTarget 1
            // New enemy: Curse is due at once, Harm/Fireball timers keep running
            settimer 'rcurse' 999999
            attack noxMain
            settimer 'attackref' 0
            if followers > 0
                say 'All kill'
                waitfortarget 1500
                if targetexists
                    target noxMain
                endif
            endif
            overhead '[ NEW TARGET ]' 68 noxMain
        endif
    endif

    // ===== 6. Rotation =====
    if HaveTarget = 1
        if timer 'attackref' >= 3000
            attack noxMain
            settimer 'attackref' 0
        endif

        // 1. Mushroom: not the action for this pass, the list goes on
        if mana < MushroomMana and timer 'rmushroom' >= 60000 and findtype 29012 self
            dclicktype 29012
            settimer 'rmushroom' 0
            wait 200
        endif

        // Is Curse due? Every CurseEvery, or at once on a new target
        @setvar! CurseDue 0
        if timer 'rcurse' >= CurseEvery
            @setvar! CurseDue 1
        elseif not inlist 'rcursed' noxMain
            @setvar! CurseDue 1
        endif
        // Enough mana for Flamestrike? Less is needed while Soulfire is up
        @setvar! FSOk 0
        if mana >= FSMana
            @setvar! FSOk 1
        elseif findbuff 'Soulfire' and mana >= FSSoulfireMana
            @setvar! FSOk 1
        endif

        // A refused heal or cure means no action this pass
        if HealFailed = 0
            // 2. Greater Explosion potion on the target
            if UseExplo = 1 and timer 'rexplo' >= ExploEvery and findtype 3853 self
                if targetexists
                    hotkey 'Cancel Current Target'
                    wait 100
                endif
                dclicktype 3853
                settimer 'rexplo' 0
                waitfortarget 2000
                if targetexists
                    target noxMain
                endif
                wait 200

            // 3. Curse: due every CurseEvery, or at once on a new target.
            // Garlic + Nightshade + Sulfurous Ash, 11 mana
            elseif CurseDue = 1 and mana >= 11 and findtype 3972 self and findtype 3976 self and findtype 3980 self
                cast 'Curse'
                // Wait for the cursor, but stop at once if the cast was refused
                for 20
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target noxMain
                    settimer 'rcurse' 0
                    clearlist 'rcursed'
                    pushlist 'rcursed' noxMain
                endif

            // 4. Harm proc: Nightshade + Spider's Silk, 6 mana
            elseif timer 'rharm' >= ProcEvery and mana >= 6 and findtype 3976 self and findtype 3981 self
                cast 'Harm'
                // Wait for the cursor, but stop at once if the cast was refused
                for 20
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target noxMain
                    settimer 'rharm' 0
                endif

            // 5. Fireball proc: Black Pearl, 9 mana
            elseif timer 'rfireball' >= ProcEvery and mana >= 9 and findtype 3962 self
                cast 'Fireball'
                // Wait for the cursor, but stop at once if the cast was refused
                for 20
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target noxMain
                    settimer 'rfireball' 0
                endif

            // 6. Flamestrike: Sulfurous Ash + Spider's Silk, 40 mana
            elseif FSOk = 1 and findtype 3980 self and findtype 3981 self
                cast 'Flamestrike'
                // Wait for the cursor, but stop at once if the cast was refused
                for 20
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target noxMain
                    // nothing to track
                endif

            // 7. Harm as cheap filler - does NOT reset the Harm proc timer
            elseif mana >= 6 and findtype 3976 self and findtype 3981 self
                cast 'Harm'
                // Wait for the cursor, but stop at once if the cast was refused
                for 20
                    if targetexists or insysmsg 'recovered' or insysmsg 'already casting'
                        break
                    endif
                    wait 100
                endfor
                if targetexists
                    target noxMain
                    // filler: the proc timer keeps running
                endif
            endif
        endif
    endif

    wait 100
endwhile

if listexists 'nox_single'
    removelist 'nox_single'
endif
if listexists 'f_player'
    removelist 'f_player'
endif
overhead 'Single target stopped' 33
